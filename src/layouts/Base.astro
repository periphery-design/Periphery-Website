---
import '../styles/global.css';
import syneUrl from '../assets/fonts/syne-variable.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string; forceTheme?: 'dark' | 'light'; }
const { title, description = 'Periphery Design — campaigns and ideas for brands.', forceTheme } = Astro.props;
const fullTitle = title ? `${title} — Periphery Design` : 'Periphery Design';
---
<!doctype html>
<html lang="en" data-force-theme={forceTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content={forceTheme ?? 'light dark'} />
    <link rel="preload" href={syneUrl} as="font" type="font/woff2" crossorigin />
    <!-- Theme before first paint: saved choice > device preference > light. -->
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        // A page can lock its theme (e.g. a project shot on black). The visitor's saved choice is untouched.
        const forced = document.documentElement.dataset.forceTheme;
        document.documentElement.dataset.theme = forced || saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.classList.add('js');
      })();
    </script>
    <!-- Page transition, after Collins (pattern only): opening a case study slides the new page up over the
         current one like a sheet, its rounded top corners flattening as it lands. Uses cross-document View
         Transitions (Chrome, Edge, Safari 18.2+); other browsers simply load the page as normal. Must run before
         first paint, so it lives inline in the head. Only case-study pages get it; everything else navigates as usual. -->
    <script is:inline>
      window.addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        var p = location.pathname.replace(/index\.html$/, '');
        var isCase = /\/work\/[^/]+\/$/.test(p);
        if (isCase && !matchMedia('(prefers-reduced-motion: reduce)').matches) e.viewTransition.types.add('sheet-up');
        else e.viewTransition.skipTransition();
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header themeLocked={!!forceTheme} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
