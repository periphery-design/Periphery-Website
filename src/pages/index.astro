---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroDock from '../components/HeroDock.astro';
import { Image } from 'astro:assets';
import glow from '../assets/backgrounds/glow.jpg';
import CapabilityPanel from '../components/CapabilityPanel.astro';
import ProcessCards from '../components/ProcessCards.astro';
import { capabilities, process } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const headline = 'Vision Beyond the Center.';
const subheading = 'Goats take in nearly 320° of the world at a glance. They’re a little weird, full of personality and completely unapologetic about it. That’s the studio: wide awake to everything around a brand, and ready to lean into the quirks that make it unmistakably itself.';
---
<Base description={subheading} dock>
  <!-- Wireframe 4: the wordmark under the nav, the campaigns in a sideways reel below it; on scroll the
       wordmark docks into the header as the logo -->
  <HeroDock projects={projects} />

  <!-- Everything after the work sits on a soft colour field (peach into lime into the iris yellow) that fades in
       from the plain page once the reel is passed, and melts back into the page before the footer -->
  <div class="glow-zone">
  <div class="glow" aria-hidden="true"><Image src={glow} alt="" widths={[1125]} sizes="100vw" format="jpg" quality={88} loading="lazy" /></div>

  <!-- The statement, just below the fold: big editorial line across the page, the subheading on the copy line -->
  <section class="grid statement-band" aria-labelledby="st-h">
    <p class="label st-label" data-reveal>Periphery Studio</p>
    <!-- Headline and subheading set as one statement in the same style, running on from each other -->
    <div class="st-text" data-reveal>
      <h2 id="st-h" class="st-h">Vision Beyond the Center<span class="st-dot" aria-hidden="true">.</span></h2>
      <p class="st-sub">{subheading}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="cap-h">
    <div class="grid sec-head">
      <h2 id="cap-h" class="label">Capabilities</h2>
      <p class="content statement" data-reveal>One idea, made to work everywhere the brand shows up.</p>
      <p class="content sec-sub" data-reveal>A multidisciplinary studio for brand identity, illustration and campaign design, working with commercial brands that would rather stand out than fit in.</p>
    </div>
    <div class="grid"><div class="full" data-reveal><CapabilityPanel items={capabilities} idPrefix="home-cap" /></div></div>
  </section>

  <section class="section" aria-labelledby="proc-h">
    <div class="grid sec-head"><h2 id="proc-h" class="label">Process</h2></div>
    <ProcessCards items={process} statement="How an idea gets from brief to the street." sub="Placeholder: a line on why the process is kept simple." />
  </section>
  </div>
</Base>

<style>
  /* ---------- The colour field behind the rest of the page ---------- */
  .glow-zone { position: relative; isolation: isolate; }
  .glow {
    position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none;
    /* fade in from the plain page at the top, full strength through the middle, back to plain before the footer */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 min(55vh, 22%), #000 82%, transparent 100%);
            mask-image: linear-gradient(to bottom, transparent 0, #000 min(55vh, 22%), #000 82%, transparent 100%);
  }
  .glow :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%;
    filter: saturate(0.78);   /* a touch softer than the source */
    /* Slow drift, like light moving across a wall: a long, gentle loop of scale and shift (transform only) */
    transform-origin: 50% 50%;
    animation: glow-drift 38s ease-in-out infinite alternate;
  }
  @keyframes glow-drift {
    0%   { transform: scale(1.12) translate(-2.5%, -1.5%) rotate(-1.5deg); }
    50%  { transform: scale(1.2) translate(2.5%, 1.5%) rotate(1deg); }
    100% { transform: scale(1.14) translate(-1%, 2.5%) rotate(-0.5deg); }
  }
  @media (prefers-reduced-motion: reduce) { .glow :global(img) { animation: none; transform: scale(1.12); } }
  /* The yellow page already has its colour, so the field steps aside there */
  :global([data-theme='yellow']) .glow { display: none; }
  /* Panels and cards on the colour turn to frosted glass, so the field shows through instead of flat grey boxes */
  :global(html:not([data-theme='yellow'])) .glow-zone :global(:is(.cap-panel, .proc-card)) {
    background: rgb(255 255 255 / 0.5); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
  }

  /* Statement band: ExtraBold line at near-display size, left-aligned on the grid; the full stop is the iris yellow */
  .statement-band { padding-block: clamp(4rem, 3rem + 6vw, 9rem) clamp(2rem, 1rem + 3vw, 4rem); row-gap: clamp(1.25rem, 1rem + 1vw, 2rem); align-items: end; }
  .st-label { grid-column: 1 / -1; }
  /* One statement across three quarters of the page (9 of 12 columns) */
  .st-text {
    grid-column: 1 / span 9;
    font-size: clamp(1.2rem, 2.96vw - 0.02rem, 2.98rem); font-weight: var(--weight-sub);   /* Bold, 5pt under the last size */
    line-height: 1.05; letter-spacing: -0.025em; text-wrap: pretty;
  }
  .st-h, .st-sub { display: inline; font: inherit; letter-spacing: inherit; color: var(--fg); }
  .st-h::after { content: ' '; }
  .st-dot { color: var(--fg); }
  @media (max-width: 800px) { .st-text { grid-column: 1 / -1; } }
  .sec-head { margin-bottom: 2.5rem; }
  .sec-sub { margin-top: 1rem; color: var(--fg-muted); max-width: 40ch; }
  .full { grid-column: 1 / -1; }
</style>
