---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroDock from '../components/HeroDock.astro';
import CapabilityPanel from '../components/CapabilityPanel.astro';
import ProcessCards from '../components/ProcessCards.astro';
import { capabilities, process } from '../data/site';
import { Image } from 'astro:assets';
import capStrategy from '../assets/projects/biotechne-immunology/phones.jpg';
import capArtDirection from '../assets/projects/biotechne-multiomics/transit-poster.jpg';
import capIllustration from '../assets/projects/little-devils/packaging.jpg';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const headline = 'Vision Beyond the Center.';

// The image beside each capability (same order as the list). Branding: left blank for now.
const capShots = [
  { image: capStrategy, focus: '55% 50%' },        // Immunology phone montage
  { image: capArtDirection, focus: '49% 45%' },    // Multiomics vertical LED in the underground
  { image: capIllustration, focus: '50% 50%' },    // Little Devils packaging
  { image: null, focus: '50% 50%' },               // Branding: to come
];
const subheading = 'Goats take in nearly 320° of the world at a glance. They’re a little weird, full of personality and completely unapologetic about it. That’s the studio: wide awake to everything around a brand, and ready to lean into the quirks that make it unmistakably itself.';
---
<Base description={subheading} dock>
  <!-- Wireframe 4: the wordmark under the nav, the campaigns in a sideways reel below it; on scroll the
       wordmark docks into the header as the logo -->
  <HeroDock projects={projects} />

  <!-- The statement, just below the fold: big editorial line across the page, the subheading on the copy line -->
  <section class="grid statement-band" aria-labelledby="st-h">
    <p class="label st-label" data-reveal>How we see it</p>
    <!-- Headline and subheading set as one statement in the same style, running on from each other -->
    <div class="st-text" data-reveal>
      <h2 id="st-h" class="st-h">Vision Beyond the Center<span class="st-dot" aria-hidden="true">.</span></h2>
      <p class="st-sub">{subheading}</p>
    </div>
  </section>

  <!-- Capabilities: a tall image on the left stays put while you read the list on the right. It changes to a piece
       of work from whichever discipline you hover, focus or open (site.ts, [data-cap-show]). Phones: image on top. -->
  <section class="section" aria-labelledby="cap-h">
    <div class="grid cap-sec" data-cap-show>
      <h2 id="cap-h" class="label cap-label">Capabilities</h2>
      <div class="cap-media" aria-hidden="true">
        <div class="cap-frame" data-reveal>
          {capabilities.map((_, i) => (
            <div class:list={['cap-shot', { 'is-on': i === 0, 'is-empty': !capShots[i]?.image }]} data-cap-shot>
              {capShots[i]?.image && <Image src={capShots[i].image!} alt="" widths={[1200, 2000]} sizes="(min-width: 800px) 1200px, 800px" quality={85} loading="lazy" style={`object-position: ${capShots[i].focus}`} />}
            </div>
          ))}
          <span class="cap-tag" data-cap-tag>{capabilities[0].name}</span>
        </div>
      </div>
      <div class="cap-body">
        <p class="statement" data-reveal>One idea, made to work everywhere the brand shows up.</p>
        <p class="sec-sub" data-reveal>A multidisciplinary studio for brand identity, illustration and campaign design, working with commercial brands that would rather stand out than fit in.</p>
        <div class="cap-list" data-reveal><CapabilityPanel items={capabilities} idPrefix="home-cap" /></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="proc-h">
    <div class="grid sec-head"><h2 id="proc-h" class="label">Process</h2></div>
    <ProcessCards items={process} statement="How an idea gets from brief to the street." sub="Placeholder: a line on why the process is kept simple." />
  </section>
</Base>

<style>
  /* Statement band: ExtraBold line at near-display size, left-aligned on the grid; the full stop is the iris yellow */
  .statement-band { padding-block: clamp(4rem, 3rem + 6vw, 9rem) clamp(2rem, 1rem + 3vw, 4rem); row-gap: clamp(1.25rem, 1rem + 1vw, 2rem); align-items: end; }
  .st-label { grid-column: 1 / -1; }
  /* One statement across three quarters of the page (9 of 12 columns) */
  .st-text {
    grid-column: 1 / span 9;
    font-size: clamp(1.2rem, 2.96vw - 0.02rem, 2.98rem); font-weight: var(--weight-sub);   /* Bold, 5pt under the last size */
    line-height: 1.05; letter-spacing: -0.025em; text-wrap: pretty;
  }
  .st-h, .st-sub { display: inline; font: inherit; letter-spacing: inherit; color: var(--fg); }
  .st-h::after { content: ' '; }
  .st-dot { color: var(--fg); }
  @media (max-width: 800px) { .st-text { grid-column: 1 / -1; } }
  .sec-head { margin-bottom: 2.5rem; }
  .sec-sub { margin-top: 1rem; color: var(--fg-muted); max-width: 40ch; }

  /* ---------- Capabilities: sticky image left, statement + list right ---------- */
  .cap-sec { row-gap: 1.5rem; align-items: start; }
  .cap-label { grid-column: 1 / -1; }
  .cap-media { grid-column: 1 / span 5; position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .cap-frame { position: relative; aspect-ratio: 4 / 5; max-height: calc(100svh - var(--header-h) - 3rem); border-radius: var(--radius); overflow: hidden; background: var(--bg-raised); }
  .cap-shot { position: absolute; inset: 0; opacity: 0; transform: scale(1.04); transition: opacity 500ms var(--ease-out), transform 900ms var(--ease-out); }
  .cap-shot.is-on { opacity: 1; transform: none; }
  .cap-shot :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cap-shot.is-empty { background: var(--bg-raised); }   /* no image yet */
  /* The discipline's name in a small pill on the image, so it's clear which one you're looking at */
  .cap-tag {
    position: absolute; left: 1rem; bottom: 1rem; padding: 0.4em 0.9em; border-radius: var(--radius-pill);
    background: var(--bg); color: var(--fg); font-size: var(--step--1); font-weight: var(--weight-medium);
  }
  .cap-body { grid-column: 7 / -1; }
  .cap-list { margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  /* The list sits in a narrower column here, so the names step down to fit */
  .cap-list :global(.cap-name) { font-size: clamp(1.6rem, 0.6rem + 2.4vw, 3rem); }
  .cap-list :global(.cap-panel) { padding: clamp(1.25rem, 0.75rem + 1.5vw, 2rem); }
  @media (prefers-reduced-motion: reduce) { .cap-shot { transition: opacity 200ms ease; transform: none; } }
  @media (max-width: 800px) {
    .cap-media { grid-column: 1 / -1; position: static; }
    .cap-frame { aspect-ratio: 4 / 3; }
    .cap-body { grid-column: 1 / -1; }
  }
  .full { grid-column: 1 / -1; }
</style>
