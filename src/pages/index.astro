---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CampaignReels from '../components/CampaignReels.astro';
import CapabilityPanel from '../components/CapabilityPanel.astro';
import ProcessCards from '../components/ProcessCards.astro';
import { capabilities, process } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const headline = 'Vision Beyond the Center.';
const subheading = 'We craft bold brand identities and high-impact visual strategies that capture attention from every angle.';
---
<Base description={subheading}>
  <!-- Brand statement front and centre (after Collins). The first case study peeks in below it. -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-inner">
      <h1 id="hero-h" class="hero-h" aria-label={headline}>
        {headline.split(' ').map((w, i) => <span class="w" style={`--d: ${i}`} aria-hidden="true">{w}</span>)}
      </h1>
      <p class="hero-sub">{subheading}</p>
    </div>
    <a class="scroll-cue" href="#work"><span class="visually-hidden">Skip to the work</span><span class="cue-line" aria-hidden="true"></span></a>
  </section>

  <section id="work" class="work" aria-labelledby="work-h">
    <div class="grid work-head">
      <h2 id="work-h" class="label">Selected work</h2>
      <p class="content meta">{projects.length} campaigns</p>
    </div>
    <CampaignReels projects={projects} />
    <div class="grid all-work"><p class="content"><a class="pill ghost" href="/work/">All work <span class="arrow" aria-hidden="true">→</span></a></p></div>
  </section>

  <section class="section" aria-labelledby="cap-h">
    <div class="grid sec-head">
      <h2 id="cap-h" class="label">Capabilities</h2>
      <p class="content statement" data-reveal>One idea, made to work everywhere the brand shows up.</p>
    </div>
    <div class="grid"><div class="full" data-reveal><CapabilityPanel items={capabilities} idPrefix="home-cap" reveal /></div></div>
  </section>

  <section class="section" aria-labelledby="proc-h">
    <div class="grid sec-head"><h2 id="proc-h" class="label">Process</h2></div>
    <ProcessCards items={process} statement="How an idea gets from brief to the street." sub="Placeholder: a line on why the process is kept simple." />
  </section>
</Base>

<style>
  /* ---------- Hero statement ---------- */
  .hero {
    position: relative;
    /* Fill the first screen minus a slice, so the top of the first case study peeks in */
    min-height: calc(100svh - var(--header-h) - clamp(4rem, 12svh, 8rem));
    display: grid; place-items: center;
    padding: clamp(3rem, 8vh, 6rem) var(--gutter);
    text-align: center;
  }
  .hero-inner { display: grid; justify-items: center; gap: clamp(1.25rem, 1rem + 1vw, 2rem); }
  .hero-h {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.45rem + 3.3vw, 3.75rem); /* 50% of the previous size, while the home page is refined */
    line-height: 1; letter-spacing: -0.03em; font-weight: var(--weight-headline);
    max-width: 14ch;
  }
  .hero-sub { font-size: clamp(0.5625rem, 0.525rem + 0.2vw, 0.6875rem); /* 50% of --step-1 */ font-weight: var(--weight-sub); color: var(--fg-muted); max-width: 40ch; line-height: var(--leading-sub); }

  /* Entrance: words rise in one after another, then the subheading */
  .w { display: inline-block; margin-inline: 0.12em; }
  .js .w { opacity: 0; transform: translateY(0.35em); animation: rise 900ms var(--ease-out) forwards; animation-delay: calc(120ms + var(--d) * 90ms); }
  .js .hero-sub, .js .scroll-cue { opacity: 0; animation: fade 900ms var(--ease-out) 650ms forwards; }
  @keyframes rise { to { opacity: 1; transform: none; } }
  @keyframes fade { to { opacity: 1; } }

  /* Scroll cue: a thin line that draws downward, pointing at the work */
  .scroll-cue { position: absolute; left: 50%; bottom: 1.25rem; translate: -50% 0; padding: 0.5rem; }
  .cue-line { display: block; width: 1px; height: 2.75rem; background: var(--line); position: relative; overflow: hidden; }
  .cue-line::after {
    content: ''; position: absolute; inset: 0; background: var(--fg);
    transform: translateY(-100%); animation: cue 2.4s var(--ease-inout) 1.4s infinite;
  }
  @keyframes cue { 0% { transform: translateY(-100%); } 55% { transform: translateY(0); } 100% { transform: translateY(100%); } }

  /* As you scroll, the statement fades and lifts away while the work comes up (where supported) */
  @supports (animation-timeline: scroll()) {
    .hero-inner { animation-name: hero-out; animation-timing-function: linear; animation-fill-mode: both; }
    /* Kept in its own rule: the CSS minifier would otherwise fold it into an invalid shorthand */
    .hero .hero-inner { animation-timeline: scroll(root); animation-range: 0 60svh; }
    @keyframes hero-out { to { opacity: 0; transform: translateY(-6vh) scale(0.97); } }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .w, .js .hero-sub, .js .scroll-cue { opacity: 1; transform: none; animation: none; }
    .cue-line::after, .hero-inner { animation: none; }
  }
  .work-head { padding-bottom: 0.75rem; }
  .all-work { padding-top: 1.5rem; }
  .sec-head { margin-bottom: 2.5rem; }
  .full { grid-column: 1 / -1; }
</style>
