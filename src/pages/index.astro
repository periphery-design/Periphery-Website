---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PeripheryField from '../components/PeripheryField.astro';
import CapabilityPanel from '../components/CapabilityPanel.astro';
import ProcessCards from '../components/ProcessCards.astro';
import { capabilities, process } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const headline = 'Vision Beyond the Center.';
const subheading = 'We craft bold brand identities and high-impact visual strategies that capture attention from every angle.';
---
<Base description={subheading}>
  <!-- Wireframe 3: the eye and the statement in the centre, the campaigns floating at the edges (the periphery) -->
  <PeripheryField projects={projects} />

  <!-- The statement, just below the fold: big editorial line across the page, the subheading on the copy line -->
  <section class="grid statement-band" aria-labelledby="st-h">
    <p class="label st-label" data-reveal>Periphery Studio</p>
    <h2 id="st-h" class="st-h" data-reveal>Vision Beyond<br />the Center<span class="st-dot" aria-hidden="true">.</span></h2>
    <p class="st-sub" data-reveal>{subheading}</p>
  </section>

  <section class="section" aria-labelledby="cap-h">
    <div class="grid sec-head">
      <h2 id="cap-h" class="label">Capabilities</h2>
      <p class="content statement" data-reveal>One idea, made to work everywhere the brand shows up.</p>
    </div>
    <div class="grid"><div class="full" data-reveal><CapabilityPanel items={capabilities} idPrefix="home-cap" reveal /></div></div>
  </section>

  <section class="section" aria-labelledby="proc-h">
    <div class="grid sec-head"><h2 id="proc-h" class="label">Process</h2></div>
    <ProcessCards items={process} statement="How an idea gets from brief to the street." sub="Placeholder: a line on why the process is kept simple." />
  </section>
</Base>

<style>
  /* Statement band: ExtraBold line at near-display size, left-aligned on the grid; the full stop is the iris yellow */
  .statement-band { padding-block: clamp(4rem, 3rem + 6vw, 9rem) clamp(2rem, 1rem + 3vw, 4rem); row-gap: clamp(1.25rem, 1rem + 1vw, 2rem); align-items: end; }
  .st-label { grid-column: 1 / -1; }
  .st-h {
    grid-column: 1 / -1;
    font-size: clamp(2.75rem, 1rem + 7.4vw, 8.5rem); font-weight: var(--weight-headline);
    line-height: 0.92; letter-spacing: -0.035em; text-wrap: balance;
  }
  .st-dot { color: #e5d838; }
  :global([data-theme='yellow']) .st-dot { color: var(--fg); }   /* on the yellow page the full stop turns black */
  .st-sub { grid-column: 7 / -1; font-size: var(--step-1); line-height: var(--leading-body); color: var(--fg-muted); max-width: 34ch; }
  @media (max-width: 800px) { .st-sub { grid-column: 1 / -1; } }
  .sec-head { margin-bottom: 2.5rem; }
  .full { grid-column: 1 / -1; }
</style>
