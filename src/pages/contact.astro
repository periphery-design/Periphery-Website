---
import Base from '../layouts/Base.astro';
---
<Base title="Contact">
  <section class="grid c-head" data-reveal>
    <h1 class="label">Contact</h1>
    <div class="content">
      <p class="c-title">Got a brief, a brand, or a half-formed idea?</p>
      <a class="email" href="mailto:hello@example.com">hello@example.com <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="grid details" data-reveal>
    <p class="label">Elsewhere</p>
    <ul class="content links">
      <li><a href="https://www.behance.net/TandersonCreative">Behance <span class="arrow" aria-hidden="true">↗</span></a></li>
      <li><a href="#">Instagram <span class="arrow" aria-hidden="true">↗</span></a></li>
      <li><a href="#">LinkedIn <span class="arrow" aria-hidden="true">↗</span></a></li>
    </ul>
  </section>
</Base>

<style>
  .c-head { padding-block: clamp(2.5rem, 2rem + 4vw, 5rem) 4rem; }
  .c-title { font-size: var(--step-2); font-weight: var(--weight-sub); max-width: 20ch; }
  .email {
    display: inline-block; margin-top: 2rem; font-size: var(--step-3); font-weight: var(--weight-sub); letter-spacing: -0.02em;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size var(--dur-med) var(--ease-out);
  }
  .email:hover, .email:focus-visible { background-size: 100% 2px; }
  .links li { border-top: 1px solid var(--line); }
  .links li:last-child { border-bottom: 1px solid var(--line); }
  .links a { display: flex; justify-content: space-between; padding-block: 1rem; font-size: var(--step-1); }
</style>
