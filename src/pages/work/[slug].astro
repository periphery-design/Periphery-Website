---
// Campaign case-study template: overview → insight (or brief/idea) → execution → results → note → next.
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import Placeholder from '../../components/Placeholder.astro';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return all.map((p, i) => ({ params: { slug: p.id }, props: { project: p, next: all[(i + 1) % all.length] } }));
}
interface Props { project: CollectionEntry<'projects'>; next: CollectionEntry<'projects'>; }
const { project, next } = Astro.props;
const d = project.data;
// Swatch label colour: dark ink on light colours, white on dark ones (WCAG relative luminance)
const lum = (hex: string) => {
  const c = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const ink = (hex: string) => (lum(hex) > 0.4 ? '#111111' : '#ffffff');
---
<Base title={`${d.client}: ${d.title}`} description={d.summary} forceTheme={d.theme}>
  <article>
    <div class="grid hero-wrap"><div class="full hero" data-reveal>
      {d.cover
        ? <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[800, 1400, 2000, 2800, 3200]} sizes="96vw" loading="eager" fetchpriority="high" />
        : <Placeholder label="Hero film or key visual" ratio="16 / 9" />}
    </div></div>


    <!-- Intro: project title in ExtraBold over the overview text. The "Overview" heading sits in the left
         column but comes after the h1 in the source so the heading order stays h1 → h2. -->
    <section class="grid band band-intro" aria-labelledby="p-title" data-reveal>
      <div class="band-text">
        <h1 id="p-title" class="p-title">{d.title}</h1>
        {d.overview.length > 0 && <div class="prose">{d.overview.map((t) => <p>{t}</p>)}</div>}
      </div>
      {d.overview.length > 0 && <h2 class="band-h intro-h">{d.overviewHeading ?? 'Overview'}</h2>}
    </section>

    <dl class="grid facts" data-reveal>
      <div><dt class="meta">Client</dt><dd>{d.client}</dd></div>
      <div><dt class="meta">Year</dt><dd>{d.year}</dd></div>
      <div><dt class="meta">Role</dt><dd>{d.role}</dd></div>
      <div><dt class="meta">Channels</dt><dd>{d.channels.join(', ')}</dd></div>
    </dl>

    {d.insight && (
      <section class="section insight" aria-labelledby="ins-h">
        <div class="grid band" data-reveal>
          <h2 id="ins-h" class="band-h">The insight</h2>
          <div class="band-text prose">{d.insight.paragraphs.map((t) => <p>{t}</p>)}</div>
        </div>
        {d.insight.image && <div class="grid" data-reveal><div class="frame"><Image src={d.insight.image} alt={d.insight.alt ?? ''} widths={[800, 1400, 2000, 2800, 3200]} sizes="96vw" /></div></div>}
      </section>
    )}

    {d.brief && (
      <section class="section grid" data-reveal>
        <h2 class="label">The brief</h2>
        <p class="content statement">{d.brief}</p>
      </section>
    )}

    {d.idea && (
      <section class="section grid" data-reveal>
        <h2 class="label">The idea</h2>
        <p class="content statement">{d.idea}</p>
      </section>
    )}

    <section class:list={['section', d.gallery.length > 0 && 'work-sec']} aria-labelledby="exec-h">
      {d.gallery.length === 0
        ? <div class="grid"><h2 id="exec-h" class="label">Execution</h2><p class="content meta">How it ran across {d.channels.length} channels</p></div>
        : <h2 id="exec-h" class="visually-hidden">The work</h2>}
      {d.gallery.length > 0 ? (
        <div class="blocks">
          {d.gallery.map((b) => b.type === 'split' ? (
            <div class="story">
              <div class="grid band" data-reveal>
                {b.heading ? <h3 class="band-h">{b.heading}</h3> : <span class="band-h" aria-hidden="true"></span>}
                <p class="band-text">{b.text}</p>
              </div>
              <div class="grid" data-reveal><div class="frame"><Image src={b.image} alt={b.alt} widths={[800, 1400, 2000, 2800, 3200]} sizes="96vw" /></div></div>
            </div>
          ) : b.type === 'text' ? (
            <div class="grid band" data-reveal>
              {b.heading ? <h2 class="band-h">{b.heading}</h2> : <span class="band-h" aria-hidden="true"></span>}
              <div class="band-text prose">{b.paragraphs.map((t) => <p>{t}</p>)}</div>
            </div>
          ) : b.type === 'bento' ? (
            <div class="story">
              {(b.heading || b.text) && (
                <div class="grid band" data-reveal>
                  {b.heading ? <h3 class="band-h">{b.heading}</h3> : <span class="band-h" aria-hidden="true"></span>}
                  {b.text && <p class="band-text">{b.text}</p>}
                </div>
              )}
              <div class="grid" data-reveal>
                <div class="bento">
                  <div class="tile t-large"><Image src={b.large.image} alt={b.large.alt} widths={[600, 1000, 1400, 1800]} sizes="(min-width: 1000px) 48vw, 100vw" /></div>
                  {b.tall.layers && b.tall.canvas ? (
                    /* Animated stack: the static image stays for phones / reduced motion / no-JS; the layers sit over it.
                       --top / --h place each slide (as % of the canvas); --off is how far it travels from the first slide. */
                    <div class="tile t-tall stack" data-stack role="img" aria-label={b.tall.alt}>
                      <Image class="stack-still" src={b.tall.image} alt="" widths={[400, 700, 900]} sizes="(min-width: 1000px) 24vw, 50vw" />
                      {b.tall.layers.map((l, i, all) => (
                        <Image class={i === 0 ? 'layer layer-first' : 'layer'} src={l.image} alt="" widths={[400, 833]} sizes="(min-width: 1000px) 24vw, 50vw"
                          style={`--i:${i}; --z:${all.length - i}; --top:${(l.top / b.tall.canvas!) * 100}; --h:${(l.height / b.tall.canvas!) * 100}; --off:${((l.top - all[0].top) / b.tall.canvas!) * 100}`} />
                      ))}
                    </div>
                  ) : (
                    <div class="tile t-tall"><Image src={b.tall.image} alt={b.tall.alt} widths={[400, 700, 900]} sizes="(min-width: 1000px) 24vw, 50vw" /></div>
                  )}
                  <div class="tile t-top"><Image src={b.smallTop.image} alt={b.smallTop.alt} widths={[400, 700, 900]} sizes="(min-width: 1000px) 24vw, 50vw" /></div>
                  <div class="tile t-bottom"><Image src={b.smallBottom.image} alt={b.smallBottom.alt} widths={[400, 700, 900]} sizes="(min-width: 1000px) 24vw, 50vw" /></div>
                </div>
              </div>
            </div>
          ) : b.type === 'principles' ? (
            <ul class="grid principles" data-reveal>
              {b.items.map((it) => <li><h3 class="pr-title">{it.title}</h3><p>{it.text}</p></li>)}
            </ul>
          ) : b.type === 'swatches' ? (
            <ul class="grid swatches" data-reveal aria-label="Colour palette">
              {b.colours.map((c) => (
                <li class="swatch" style={`--sw:${c.hex}; --sw-ink:${ink(c.hex)}`}>
                  <span class="sw-name">{c.name}</span>
                  <dl class="sw-values">
                    {c.pms && <div><dt>PMS</dt><dd>{c.pms}</dd></div>}
                    {c.cmyk && <div><dt>CMYK</dt><dd>{c.cmyk}</dd></div>}
                    {c.rgb && <div><dt>RGB</dt><dd>{c.rgb}</dd></div>}
                    <div><dt>HEX</dt><dd>{c.hex.toUpperCase()}</dd></div>
                  </dl>
                </li>
              ))}
            </ul>
          ) : b.type === 'trio' ? (
            <div class="grid trio" data-reveal>
              <div class="trio-main" style={b.bg ? `--trio-bg:${b.bg}` : undefined}><Image src={b.main.image} alt={b.main.alt} widths={[800, 1200, 1600, 2000]} sizes="(min-width: 800px) 66vw, 100vw" /></div>
              <div class="trio-side">
                <Image src={b.top.image} alt={b.top.alt} widths={[500, 800, 1200]} sizes="(min-width: 800px) 33vw, 100vw" />
                <Image src={b.bottom.image} alt={b.bottom.alt} widths={[500, 800, 1200]} sizes="(min-width: 800px) 33vw, 100vw" />
              </div>
            </div>
          ) : b.type === 'grid' ? (
            <div class="grid img-grid" data-reveal style={b.ratio ? `--grid-ratio: ${b.ratio}` : undefined}>
              {b.images.map((g) => <div class="img-wrap"><Image src={g.image} alt={g.alt} widths={[600, 1000, 1400, 2000]} sizes="(min-width: 800px) 50vw, 100vw" /></div>)}
            </div>
          ) : (
            <figure class:list={['grid', 'img-block', b.size]} data-reveal>
              <div class:list={['img-wrap', b.size !== 'half' && 'frame']} style={b.bg ? `background:${b.bg}` : undefined}><Image src={b.image} alt={b.alt} widths={[800, 1400, 2000, 2800, 3200]} sizes={b.size === 'half' ? '(min-width: 800px) 50vw, 100vw' : '96vw'} /></div>
              {b.caption && <figcaption class="meta">{b.caption}</figcaption>}
            </figure>
          ))}
        </div>
      ) : (
        <div class="grid gallery">
          <div class="g-wide" data-reveal><Placeholder label="OOH / billboard" ratio="16 / 9" /></div>
          <div class="g-half" data-reveal><Placeholder label="Social post" ratio="4 / 5" /></div>
          <div class="g-half" data-reveal><Placeholder label="Social post" ratio="4 / 5" /></div>
          <div class="g-third" data-reveal><Placeholder label="Story / reel" ratio="9 / 16" /></div>
          <div class="g-two-thirds" data-reveal><Placeholder label="Film still or experiential" ratio="4 / 3" /></div>
        </div>
      )}
    </section>

    {d.results.length > 0 && (
      <section class="section grid" data-reveal>
        <h2 class="label">Results</h2>
        <ul class="content results">
          {d.results.map((r) => <li><span class="r-val">{r.value}</span><span class="meta">{r.label}</span></li>)}
        </ul>
      </section>
    )}
    {d.note && (
      <aside class="section grid note" data-reveal>
        <h2 class="label">Note</h2>
        <p class="content">{d.note}</p>
      </aside>
    )}
  </article>

  <nav class="section grid next" aria-label="Next project">
    <p class="label">Next project</p>
    <a class="content next-link" href={`/work/${next.id}/`}>
      <span class="meta">{next.data.client}</span>
      <span class="next-title">{next.data.title} <span class="arrow" aria-hidden="true">↗</span></span>
      <div class="next-media">
        {next.data.cover
          ? <Image src={next.data.cover} alt="" widths={[800, 1400]} sizes="(min-width: 800px) 50vw, 100vw" />
          : <Placeholder label={`${next.data.client} — key visual`} ratio="16 / 7" />}
      </div>
    </a>
  </nav>
</Base>

<style>
  .hero-wrap { padding-top: clamp(0.75rem, 0.5rem + 0.8vw, 1.5rem); }
  /* Intro band: ExtraBold title over the overview text, "Overview" heading in the left column */
  .band.band-intro { padding-top: var(--flow); }
  .intro-h { grid-row: 1; }
  .p-title { font-size: calc(var(--step-3) * 0.8); font-weight: var(--weight-headline); line-height: 1.02; letter-spacing: -0.02em; margin-bottom: clamp(1rem, 0.75rem + 1vw, 1.75rem); }
  .full { grid-column: 1 / -1; }

  .facts { margin-top: var(--flow); row-gap: 1.5rem; }
  .facts > div { grid-column: span 3; border-top: 1px solid var(--line); padding-top: 0.75rem; }
  .facts dd { margin-top: 0.25rem; }
  @media (max-width: 800px) { .facts > div { grid-column: span 6; } }

  .gallery { margin-top: 2rem; row-gap: var(--gutter); }
  .g-wide { grid-column: 1 / -1; }
  .g-half { grid-column: span 6; }
  .g-third { grid-column: span 4; }
  .g-two-thirds { grid-column: span 8; align-self: end; }
  @media (max-width: 800px) {
    .g-half, .g-third, .g-two-thirds { grid-column: 1 / -1; }
  }

  .results { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--gutter); }
  .results li { border-top: 1px solid var(--line); padding-top: 0.75rem; display: grid; gap: 0.25rem; }
  .r-val { font-size: var(--step-3); font-weight: var(--weight-headline); line-height: 1; letter-spacing: -0.02em; }

  .next { border-top: 1px solid var(--line); padding-top: 1.25rem; margin-top: var(--section); }
  .next-link { display: grid; gap: 0.4rem; }
  .next-title { font-size: var(--step-2); font-weight: var(--weight-sub); line-height: var(--leading-sub); }
  .next-media { margin-top: 1rem; border-radius: var(--radius); overflow: hidden; aspect-ratio: 16 / 7; }
  .next-media :global(img), .next-media :global(.ph) { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  @media (hover: hover) { .next-link:hover .next-media :global(img), .next-link:hover .next-media :global(.ph) { transform: scale(1.03); } }

  /* Real images */
  .hero :global(img), .img-wrap :global(img) { width: 100%; height: auto; border-radius: var(--radius); }

  /* Full-width image frame. 16:9 exports fill it edge to edge; anything taller is capped at the screen
     height and centred on a raised panel, so a portrait image never towers over the page. */
  .frame {
    grid-column: 1 / -1; display: flex; justify-content: center;
    background: var(--bg-raised); border-radius: var(--radius); overflow: hidden;
  }
  .frame :global(img) { width: 100%; height: auto; max-height: 90svh; object-fit: contain; border-radius: 0; }
  .blocks { display: grid; gap: var(--flow); margin-top: 2rem; }
  .story { display: grid; gap: var(--flow); }
  /* Real projects: the story starts close under the facts row, matching the tighter text/image rhythm */
  .work-sec { padding-top: var(--flow); }
  .work-sec .blocks { margin-top: 0; }

  /* Text band: the story text on its own between images. Heading on the left, text across ~60%
     (7 of 12 columns) on the right, so paragraphs run wide and short. */
  /* Spacing comes only from the gap between blocks (var(--flow)), so every text band has the same space above and below */
  .band { padding-block: 0; align-items: start; row-gap: 0.75rem; }
  .band-h { grid-column: 1 / span 6; font-size: var(--step-1); font-weight: var(--weight-sub); line-height: var(--leading-sub); }
  /* Copy starts at column 7, the same line as 'Role' in the facts row; 80% of the previous size */
  .band-text { grid-column: 7 / -1; font-size: calc(var(--step-1) * 0.8); line-height: var(--leading-body); max-width: 62ch; }
  .insight .band, .band-first { padding-top: 0; }
  .band-text.prose { max-width: 62ch; }
  @media (max-width: 800px) { .band-h, .band-text { grid-column: 1 / -1; } }
  .img-block .img-wrap, .img-block figcaption { grid-column: 1 / -1; }
  .img-block.half .img-wrap { grid-column: span 6; }
  .img-block figcaption { margin-top: 0.6rem; }

  /* Overview + insight */
  .prose { display: grid; gap: 1.1em; max-width: 58ch; }
  .lead { font-size: var(--step-1); line-height: var(--leading-body); }
  .img-grid { row-gap: var(--gutter); }

  /* Bento: large | tall | two stacked small. Tile shapes match the export sizes (5:6, 5:12, 5:7, 15:14).
     Columns are weighted 2 : 1 : 1 and the large tile's 5:6 shape sets the height; the small tiles split it 3 : 2. */
  .bento {
    grid-column: 1 / -1; display: grid; gap: var(--gutter);
    grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 3fr 2fr;
  }
  .tile { position: relative; overflow: hidden; border-radius: var(--radius); background: #000; }
  /* Images are taken out of the flow so only the tile shapes decide the layout (edges line up exactly) */
  .tile :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .t-large { grid-row: 1 / 3; aspect-ratio: 5 / 6; }
  .t-tall { grid-row: 1 / 3; grid-column: 2; }
  .t-top { grid-column: 3; grid-row: 1; }
  .t-bottom { grid-column: 3; grid-row: 2; }
  /* ---------- Animated slide stack (prototype) ----------
     The tile is a size container, so 1cqh = 1% of its height and every layer can be placed and moved
     in the image's own coordinates. Collapsed: every slide sits at the first slide's position, under it.
     .is-open: each slide travels down to its place in turn and fades up. */
  .stack { container-type: size; background: #070707; }
  .stack :global(.layer) {
    position: absolute; left: 0; width: 100%; inset-block: auto; object-fit: fill;
    top: calc(var(--top) * 1%); height: calc(var(--h) * 1%); z-index: var(--z);
    transform: translateY(calc(var(--off) * -1cqh)); opacity: 0;
    transition: transform 1100ms cubic-bezier(0.22, 1, 0.36, 1), opacity 700ms ease-out;
    transition-delay: calc(var(--i) * 140ms);
  }
  .stack :global(.layer-first) { opacity: 1; }
  .stack:global(.is-open) :global(.layer) { transform: none; opacity: 1; }
  .stack :global(.stack-still) { opacity: 0; }          /* hidden while the layers are in charge */
  /* No JS, reduced motion, or phones (where the tile is cropped): show the finished still image */
  :global(html:not(.js)) .stack :global(.layer) { display: none; }
  :global(html:not(.js)) .stack :global(.stack-still) { opacity: 1; }
  @media (prefers-reduced-motion: reduce), (max-width: 600px) {
    .stack :global(.layer) { display: none; }
    .stack :global(.stack-still) { opacity: 1; }
  }

  /* Tablet: large tile full width, then tall beside the stacked pair */
  @media (max-width: 1000px) {
    .bento { grid-template-columns: 1fr 1fr; grid-template-rows: auto 3fr 2fr; }
    .t-large { grid-column: 1 / -1; grid-row: 1; aspect-ratio: 5 / 4; }
    .t-tall { grid-column: 1; grid-row: 2 / 4; }
    .t-top { grid-column: 2; grid-row: 2; aspect-ratio: 5 / 7; }
    .t-bottom { grid-column: 2; grid-row: 3; aspect-ratio: 15 / 14; }
  }
  /* Phone: one tile per row; the tall tile is trimmed so it isn't several screens long */
  @media (max-width: 600px) {
    .bento { grid-template-columns: 1fr; grid-template-rows: none; }
    .t-large, .t-tall, .t-top, .t-bottom { grid-column: 1; grid-row: auto; }
    .t-large { aspect-ratio: 5 / 6; }
    .t-tall { aspect-ratio: 4 / 5; }
    .t-top { aspect-ratio: 5 / 7; }
    .t-bottom { aspect-ratio: 15 / 14; }
  }
  .img-grid .img-wrap { grid-column: span 6; }
  .img-grid :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: var(--grid-ratio, 16 / 9); border-radius: var(--radius); }
  /* Principles: three short points under a text band, each with a hairline rule like the facts row */
  .principles { row-gap: 1.5rem; }
  .principles li { grid-column: span 4; border-top: 1px solid var(--line); padding-top: 0.75rem; display: grid; gap: 0.4rem; align-content: start; }
  .pr-title { font-size: calc(var(--step-1) * 0.8); font-weight: var(--weight-sub); line-height: var(--leading-sub); }
  .principles p { font-size: calc(var(--step-1) * 0.8); max-width: 40ch; }
  @media (max-width: 800px) { .principles li { grid-column: 1 / -1; } }

  /* Swatches: real colour, live values. A hairline keeps a light swatch visible on a light page. */
  .swatches { row-gap: var(--gutter); }
  .swatch {
    grid-column: span 4; aspect-ratio: 4 / 3; border-radius: var(--radius);
    background: var(--sw); color: var(--sw-ink); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 10%, transparent);
    padding: clamp(1rem, 0.7rem + 1vw, 1.5rem); display: flex; flex-direction: column; justify-content: space-between;
  }
  .sw-name { font-size: calc(var(--step-1) * 0.8); font-weight: var(--weight-sub); line-height: var(--leading-sub); }
  .sw-values { display: grid; gap: 0.15rem; font-size: var(--step--1); }
  .sw-values div { display: grid; grid-template-columns: 3.5em 1fr; }
  @media (max-width: 800px) { .swatch { grid-column: 1 / -1; aspect-ratio: auto; min-height: 9rem; gap: 2rem; } }

  /* Trio: main card (8 cols) beside a stacked pair (4 cols). The pair's natural heights set the row;
     the main image sits centred on its own card colour, so the extra height reads as card, not gap. */
  .trio { row-gap: var(--gutter); }
  .trio-main { grid-column: 1 / span 8; position: relative; overflow: hidden; border-radius: var(--radius); background: var(--trio-bg, var(--bg-raised)); }
  .trio-main :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .trio-side { grid-column: 9 / -1; display: grid; gap: var(--gutter); align-content: start; }
  .trio-side :global(img) { width: 100%; height: auto; border-radius: var(--radius); }
  @media (max-width: 800px) {
    .trio-main { grid-column: 1 / -1; aspect-ratio: 16 / 9; }
    .trio-side { grid-column: 1 / -1; }
  }

  .note { border-top: 1px solid var(--line); padding-top: 1.25rem; margin-top: var(--section); }
  .note p { color: var(--fg-muted); max-width: 64ch; }
  @media (max-width: 800px) {
    .img-grid .img-wrap, .img-block.half .img-wrap { grid-column: 1 / -1; }
  }

</style>
