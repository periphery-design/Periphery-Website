---
// Capabilities as a hover-reveal list, after General Condition (pattern only, our own build).
// Mouse: hovering a name rolls it up, dims the rest, and an image card follows the cursor with a soft lag.
//        Inside the card, images slide up or down depending on the direction you move through the list.
// Keyboard: focusing a name does the same, with the card parked beside that name.
// Touch: the card sits under the list; tapping a name shows its image (the first is shown to start).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Cap { name: string; image: ImageMetadata; alt: string; }
interface Props { items: Cap[]; }
const { items } = Astro.props;
---
<div class="rv" data-cap-reveal>
  <ul class="rv-list">
    {items.map((c, i) => (
      <li>
        <button type="button" class="rv-row" data-i={i} aria-pressed="false">
          <span class="roll">
            <span class="roll-a">{c.name}</span>
            <span class="roll-b" aria-hidden="true">{c.name}</span>
          </span>
        </button>
      </li>
    ))}
  </ul>
  <div class="rv-card" aria-hidden="true">
    {items.map((c, i) => (
      <div class="rv-img" data-i={i}>
        <Image src={c.image} alt="" widths={[480, 800, 1000]} sizes="(min-width: 800px) 30vw, 92vw" loading="lazy" />
      </div>
    ))}
  </div>
</div>

<style>
  .rv { position: relative; padding-block: clamp(1rem, 0.5rem + 2vw, 2.5rem); }
  .rv-list { display: grid; justify-items: center; position: relative; z-index: 2; }
  .rv-row {
    font-size: clamp(1.9rem, 0.5rem + 6.9vw, 7.5rem);  /* "Art Direction" stays on one line down to phone width */
    white-space: nowrap;
    font-weight: var(--weight-headline); line-height: 1.04; letter-spacing: -0.035em;
    text-align: center; transition: opacity var(--dur-fast) var(--ease-out);
  }
  .rv-row:focus-visible { outline-offset: 0.08em; }
  /* Others dim while one is active (greyscale for now; this is where a colour change can go later) */
  .rv.is-active .rv-row:not(.is-on) { opacity: 0.25; }

  /* Rolling name, same motion as the homepage project titles */
  .roll {
    --roll-ease: cubic-bezier(0.76, 0, 0.24, 1);
    --roll-dur: 550ms;
    display: grid; overflow: hidden;
    padding-block: 0.08em 0.14em; margin-block: -0.08em -0.14em;
  }
  .roll > span { grid-area: 1 / 1; transition: transform var(--roll-dur) var(--roll-ease); }
  .roll-b { transform: translateY(115%); }
  .rv-row.is-on .roll-a { transform: translateY(-115%); }
  .rv-row.is-on .roll-b { transform: none; }

  /* The card: a window the images slide through */
  .rv-card {
    position: relative; overflow: hidden; border-radius: var(--radius);
    background: var(--bg-raised); aspect-ratio: 3 / 2;
    width: min(100%, 34rem); margin: clamp(1.5rem, 1rem + 2vw, 2.5rem) auto 0;
  }
  .rv-img {
    position: absolute; inset: 0;
    transform: translateY(101%);   /* 101%: no sub-pixel sliver of the next image at the edge */
    transition: transform var(--dur-slide, 550ms) cubic-bezier(0.76, 0, 0.24, 1);
  }
  .rv-img.is-before { transform: translateY(-101%); }
  .rv-img.is-on { transform: none; }
  .rv-img :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* Mouse: the card floats over the list and follows the pointer (positioned from JS with transform) */
  @media (hover: hover) and (pointer: fine) {
    .rv-card {
      position: absolute; top: 0; left: 0; margin: 0; z-index: 1; pointer-events: none;
      width: clamp(15rem, 10rem + 14vw, 26rem);
      opacity: 0; transition: opacity 300ms var(--ease-out);
      will-change: transform;
    }
    .rv.is-active .rv-card { opacity: 1; }
  }

  /* Reduced motion: no rolling or sliding, images cross-fade instead (the card also stops trailing; see site.ts) */
  @media (prefers-reduced-motion: reduce) {
    .roll-b { display: none; }
    .rv-row.is-on .roll-a { transform: none; }
    .rv-img, .rv-img.is-before { transform: none; opacity: 0; transition: opacity 200ms ease; }
    .rv-img.is-on { opacity: 1; }
  }
</style>
