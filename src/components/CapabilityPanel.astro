---
// Capabilities, after Spiegel: large discipline names stacked tight inside a rounded panel.
// Hover (or tap / keyboard) opens a row to show a line and service tags; the other rows dim and the name rolls.
// With images (home page), a card trails the mouse over the text, after General Condition: images slide up or
// down inside it depending on which way you move through the list. Keyboard parks the card beside the row;
// on touch there is no card, the image sits inside the opened row instead.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Cap { name: string; line: string; tags: string[]; image?: ImageMetadata; alt?: string; }
interface Props { items: Cap[]; idPrefix: string; reveal?: boolean; }
const { items, idPrefix, reveal = false } = Astro.props;
const withImages = reveal && items.every((c) => c.image);
---
<div class="cap-panel" data-cap-reveal={withImages ? '' : undefined}>
  <ol class="caps" data-caps>
    {items.map((c, i) => (
      <li class="cap" data-expand-item>
        <h3>
          <button type="button" class="cap-trigger" data-expand aria-expanded="false" aria-controls={`${idPrefix}-${i}`}>
            <span class="cap-name roll">
              <span class="roll-a">{c.name}</span>
              <span class="roll-b" aria-hidden="true">{c.name}</span>
            </span>
            <span class="cap-num" aria-hidden="true">{i + 1}</span>
          </button>
        </h3>
        <div class="cap-body" id={`${idPrefix}-${i}`}>
          <div class="cap-inner">
            <p class="cap-line">{c.line}</p>
            <ul class="tags">{c.tags.map((t) => <li>{t}</li>)}</ul>
            {withImages && <div class="cap-media"><Image src={c.image!} alt={c.alt ?? ''} widths={[480, 800]} sizes="92vw" loading="lazy" /></div>}
          </div>
        </div>
      </li>
    ))}
  </ol>
  {withImages && (
    <div class="rv-card" aria-hidden="true">
      {items.map((c) => (
        <div class="rv-img"><Image src={c.image!} alt="" widths={[480, 800]} sizes="26rem" loading="lazy" /></div>
      ))}
    </div>
  )}
</div>

<style>
  .cap-panel {
    position: relative;
    background: var(--bg-raised);
    border-radius: calc(var(--radius) * 1.25);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
  }
  .cap { border-bottom: 1px solid var(--line); transition: opacity var(--dur-fast) var(--ease-out); }
  .cap:last-child { border-bottom: 0; }
  .cap-trigger {
    width: 100%; display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    padding-block: 0.6rem; text-align: left;
  }
  .cap-name { font-family: var(--font-display); font-size: min(var(--step-3), 7.8vw);  /* longest word ("Illustration") fits a phone */
    font-weight: var(--weight-headline); letter-spacing: -0.03em; line-height: 1; }
  .cap-num { font-size: var(--step-2); font-weight: var(--weight-sub); color: var(--fg-muted); font-variant-numeric: tabular-nums; }

  /* Rolling name, same motion as the homepage project titles */
  .roll {
    --roll-ease: cubic-bezier(0.76, 0, 0.24, 1);
    --roll-dur: 550ms;
    display: grid; overflow: hidden;
    padding-block: 0.08em 0.22em; margin-block: -0.08em -0.22em;  /* room for Syne's deep descenders (g, y) */
  }
  .roll > span { grid-area: 1 / 1; transition: transform var(--roll-dur) var(--roll-ease); }
  .roll-b { transform: translateY(135%); }   /* parked fully below the window, i-dots included */
  .cap.is-open .roll-a, .cap-trigger:focus-visible .roll-a { transform: translateY(-135%); }
  .cap.is-open .roll-b, .cap-trigger:focus-visible .roll-b { transform: none; }

  .cap-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows var(--dur-med) var(--ease-inout); }
  .cap-inner {
    overflow: hidden; min-height: 0;
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 1rem 2rem; align-items: start;
  }
  .cap-line, .tags, .cap-media { opacity: 0; transform: translateY(-6px); transition: opacity var(--dur-med) var(--ease-out), transform var(--dur-med) var(--ease-out); }
  .cap-line { color: var(--fg-muted); max-width: 46ch; padding-bottom: 1.25rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: flex-end; padding-bottom: 1.25rem; }
  .tags li {
    font-size: var(--step--1); padding: 0.3em 0.8em; border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line); white-space: nowrap;
  }
  /* Touch only: the image lives inside the opened row */
  .cap-media { grid-column: 1 / -1; margin-bottom: 1.25rem; border-radius: var(--radius); overflow: hidden; aspect-ratio: 3 / 2; }
  .cap-media :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* Open state: clicked/tapped/keyboard (.is-open) or hovered on devices with a mouse */
  .cap.is-open .cap-body { grid-template-rows: 1fr; }
  .cap.is-open :is(.cap-line, .tags, .cap-media) { opacity: 1; transform: none; transition-delay: 80ms; }
  @media (hover: hover) {
    .caps:hover .cap:not(:hover) { opacity: 0.4; }
    .cap:hover .cap-body { grid-template-rows: 1fr; }
    .cap:hover :is(.cap-line, .tags) { opacity: 1; transform: none; transition-delay: 80ms; }
    .cap:hover .roll-a { transform: translateY(-135%); }
    .cap:hover .roll-b { transform: none; }
  }

  /* Cursor card: floats over the text, positioned from JS with transform. Mouse only. */
  .rv-card { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .cap-media { display: none; }
    .rv-card {
      display: block; position: absolute; top: 0; left: 0; z-index: 3; pointer-events: none;
      width: clamp(14rem, 9rem + 13vw, 24rem); aspect-ratio: 3 / 2;
      overflow: hidden; border-radius: var(--radius); background: var(--bg);
      box-shadow: 0 1.5rem 3rem -1rem rgb(0 0 0 / 0.35);
      opacity: 0;
      transition: opacity 300ms var(--ease-out);
      will-change: transform;
    }
    [data-cap-reveal].is-active .rv-card { opacity: 1; }
  }
  .rv-img {
    position: absolute; inset: 0;
    transform: translateY(101%);   /* 101%: no sub-pixel sliver of the next image at the edge */
    transition: transform 550ms cubic-bezier(0.76, 0, 0.24, 1);
  }
  .rv-img.is-before { transform: translateY(-101%); }
  .rv-img.is-on { transform: none; }
  .rv-img :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* Reduced motion: no rolling or sliding; images swap in place */
  @media (prefers-reduced-motion: reduce) {
    .roll-b { display: none; }
    .cap .roll-a, .cap.is-open .roll-a, .cap:hover .roll-a, .cap-trigger:focus-visible .roll-a { transform: none; }
    .rv-img, .rv-img.is-before { transform: none; opacity: 0; }
    .rv-img.is-on { opacity: 1; }
  }

  @media (max-width: 800px) {
    .cap-inner { grid-template-columns: 1fr; }
    .tags { justify-content: flex-start; }
  }
</style>
