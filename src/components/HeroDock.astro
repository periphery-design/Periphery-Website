---
// Wireframe 4 homepage hero: the big Periphery Studio wordmark (with the living eye in the "o") straight under
// the navigation, and the campaigns in a sideways reel underneath. The wordmark stays put and scrolls away with
// the page; once it has gone, the small header lockup drops into the top-left corner (site.ts, Header.astro).
import type { CollectionEntry } from 'astro:content';
import LogoEye from './LogoEye.astro';
import HomeReel from './HomeReel.astro';

interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;
---
<section class="hd" aria-label="Periphery Studio — selected work" data-pf>
  <h1 class="hd-mark">
    <span class="dock-space" data-dock-mover><LogoEye /></span>
  </h1>
  <div class="hd-reel"><HomeReel projects={projects} /></div>
</section>

<style>
  .hd { padding-top: clamp(1.25rem, 0.5rem + 2.5vw, 3.25rem); overflow-x: clip; }   /* room between the nav and the wordmark */
  /* Full bleed: the wordmark runs edge to edge, a hair inside the window */
  .hd-mark { margin-inline: calc(var(--gutter) * -0.4); }
  .dock-space { display: block; aspect-ratio: 950 / 222; }
  .hd-reel { margin-top: clamp(1.75rem, 0.75rem + 3vw, 4rem); }   /* and between the wordmark and the work */
  /* A slightly shorter reel than wireframe 2, so wordmark + cards fit one laptop screen */
  .hd-reel :global(.reel) { --card-h: clamp(16rem, 6rem + 22vw, 28rem); }
  @media (max-width: 800px) { .hd-reel :global(.reel) { --card-h: 90vw; } }
</style>
