<style>
  .logo-eye { display: block; width: 100%; height: auto; color: var(--fg); overflow: visible; }
  .lg-letters path, .lg-ring, .lg-lid { fill: currentColor; }
  .lg-pupil path { fill: #111; }   /* the pupil stays black in both themes */
  .lg-reg { fill: currentColor; font-family: var(--font-sans); font-size: 166.17px; font-weight: var(--weight-headline); }
  /* A hairline stroke in the letter colour seals the joins between the ring, the p's stem and the lids
     (browsers anti-alias abutting shapes separately, which leaves a faint light seam) */
  .lg-ring { stroke: currentColor; stroke-width: 3; }
  .lg-iris { fill: #e5d838; stroke: transparent; stroke-width: 6; transition: fill 90ms ease-in, stroke 90ms ease-in; }
  .lg-glint { fill: #fff; transition: opacity 120ms ease; }
  /* Lids rest just outside the eye; squint closes them a little, a blink closes them fully */
  .lg-lid { transition: transform 220ms var(--ease-out); }
  :global([data-pf].is-looking) .lg-lid-top { transform: translateY(16px); }   /* light squint: stops above the pupil, even when it looks up */
  :global([data-pf].is-looking) .lg-lid-bottom { transform: translateY(-11px); }
  .logo-eye:global(.is-blinking) .lg-lid { transition-duration: 90ms; transition-timing-function: ease-in; }
  .logo-eye:global(.is-blinking) .lg-lid-top { transform: translateY(62px); }
  .logo-eye:global(.is-blinking) .lg-lid-bottom { transform: translateY(-50px); }
  .logo-eye:global(.is-blinking) .lg-glint { opacity: 0; }
  /* While shut, the whole eye is one solid shape in the letter colour, so no seam can show */
  .logo-eye:global(.is-blinking) .lg-iris { fill: currentColor; stroke: currentColor; }
  @media (prefers-reduced-motion: reduce) { .lg-lid, .lg-glint { transition: none; } }
</style>
