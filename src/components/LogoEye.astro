---
// Periphery Studio wordmark with a living goat eye in the "o" of Studio, at the edge of the lockup, looking in.
// Built from the owner's wordmark (src/assets/logo/periphery-studio-o.svg). Layers: letters; the yellow iris
// (the o's own counter); the slit pupil (moves toward the cursor) and two lids, both clipped to the counter;
// the o drawn again on top so its edge seals the iris; the white highlight.
// Behaviour lives in site.ts ([data-logo-eye]); the eye's centre and reach are passed as data attributes.
import { letters, o, counter, wordViewBox } from '../lib/logo';
interface Props { label?: string; }
const { label = 'Periphery Studio' } = Astro.props;
---
<svg class="logo-eye" viewBox={wordViewBox} role="img" aria-label={label} data-logo-eye
  data-eye-x="692.9" data-eye-y="250.1" data-eye-max-x="7.5" data-eye-max-y="3">
  <defs>
    <clipPath id="lg-eye-clip"><path d={counter} /></clipPath>
  </defs>
  <g class="lg-letters">{letters.map((d) => <path d={d} />)}</g>
  <g class="lg-eye">
    <path class="lg-iris" d={counter} />
    <g clip-path="url(#lg-eye-clip)">
      <g class="lg-pupil" data-eye-pupil><rect x="676" y="247" width="34" height="6.2" rx="3.1" /></g>
      <rect class="lg-lid lg-lid-top" x="655" y="221" width="76" height="16.4" />
      <rect class="lg-lid lg-lid-bottom" x="655" y="263.4" width="76" height="16" />
    </g>
    <path class="lg-ring" d={o} />
    <circle class="lg-glint" cx="677.6" cy="243.6" r="5.6" data-eye-glint />
  </g>
</svg>

<style>
  .logo-eye { display: block; width: 100%; height: auto; color: var(--fg); overflow: visible; }
  .lg-letters path, .lg-ring, .lg-lid { fill: currentColor; }
  .lg-pupil rect { fill: #111; }   /* the pupil stays black in both themes */
  /* A hairline stroke in the letter colour seals the join between the o and the iris and lids
     (browsers anti-alias abutting shapes separately, which leaves a faint light seam) */
  .lg-ring { stroke: currentColor; stroke-width: 0.8; }
  .lg-iris { fill: #e5d838; transition: fill 90ms ease-in; }
  .lg-glint { fill: #fff; transition: opacity 120ms ease; }
  /* Lids rest just outside the counter; squint closes them a little, a blink closes them fully */
  .lg-lid { transition: transform 220ms var(--ease-out); }
  :global(.is-looking) .lg-lid-top { transform: translateY(4px); }
  :global(.is-looking) .lg-lid-bottom { transform: translateY(-3px); }
  .logo-eye:global(.is-blinking) .lg-lid { transition-duration: 90ms; transition-timing-function: ease-in; }
  .logo-eye:global(.is-blinking) .lg-lid-top { transform: translateY(15px); }
  .logo-eye:global(.is-blinking) .lg-lid-bottom { transform: translateY(-14px); }
  .logo-eye:global(.is-blinking) .lg-glint { opacity: 0; }
  /* While shut, the eye is one solid shape in the letter colour, so no seam can show */
  .logo-eye:global(.is-blinking) .lg-iris { fill: currentColor; }
  @media (prefers-reduced-motion: reduce) { .lg-lid, .lg-glint { transition: none; } }
</style>
