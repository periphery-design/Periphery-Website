---
// Periphery Studio wordmark, with the bowl of the "p" as a living goat eye.
// Layers (from the owner's logo SVG, src/assets/logo/periphery-studio-source.svg): letters, the yellow iris,
// the slit pupil (moves toward the cursor), two lids in the ring colour (squint on a project, random blinks),
// the ring drawn on top so the lids tuck under it, and the white highlight.
// Behaviour lives in site.ts ([data-logo-eye]); viewBox is cropped to the lettering.
interface Props { label?: string; }
const { label = 'Periphery Studio' } = Astro.props;
