---
// Wireframe 2: each campaign is a header (number, title, description, pills, link) above a draggable reel of
// its work. Mouse: Blossom drag with momentum and snapping. Touch: native swipe with scroll-snap. Keyboard:
// Previous / Next buttons, and the reel itself is focusable so arrow keys scroll it.
// Words in the reel: a channel label under every image, and one statement card with a line from the campaign.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import '@blossom-carousel/core/style.css';

interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<ol class="reels">
  {projects.map((p, i) => {
    const d = p.data;
    const href = `/work/${p.id}/`;
    const reel = d.reel.length ? d.reel : null;
    return (
      <li class="reel-item" style={`--accent: ${d.accent ?? 'var(--fg)'}`}>
        <header class="grid reel-head">
          <div class="rh-left">
            <span class="rh-num meta">{pad(i + 1)} / {pad(projects.length)}</span>
            <h3 class="rh-title"><a href={href}>{d.title}</a></h3>
          </div>
          <div class="rh-right">
            <p class="rh-summary">{d.summary}</p>
            <div class="rh-foot">
              {d.tags.length > 0 && <ul class="rh-tags" aria-label="Disciplines">{d.tags.map((t) => <li>{t}</li>)}</ul>}
              <a class="pill ghost rh-link" href={href}>View case study <span class="arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </header>

        <div class="reel-wrap" data-reel>
          <ul class="reel" blossom-carousel tabindex="0" aria-label={`${d.title} — the work`}>
            {reel ? reel.map((s) => 'quote' in s ? (
              <li class="slide slide-quote"><p class="quote">{s.quote}</p></li>
            ) : (
              <li class="slide" style={`--r: ${s.image.width / s.image.height}`}>
                <figure>
                  <div class="slide-media"><Image src={s.image} alt={`${d.title} — ${s.label}`} widths={[500, 800, 1200]} sizes="60vw" loading="lazy" /></div>
                  <figcaption class="meta">{s.label}</figcaption>
                </figure>
              </li>
            )) : [1, 2, 3].map((n) => (
              <li class="slide" style="--r: 1.4"><figure><div class="slide-media"><Placeholder label={`${d.client} — image ${n}`} ratio="7 / 5" /></div><figcaption class="meta">Channel</figcaption></figure></li>
            ))}
            <li class="slide slide-end">
              <a href={href} class="end-card">
                <span class="meta">Full campaign</span>
                <span class="end-title">See the case study <span class="arrow" aria-hidden="true">↗</span></span>
              </a>
            </li>
          </ul>
          <div class="grid reel-foot">
            <div class="progress" aria-hidden="true"><span class="progress-fill"></span></div>
            <div class="reel-nav">
              <button type="button" class="pill ghost" data-reel-prev>Previous</button>
              <button type="button" class="pill ghost" data-reel-next>Next</button>
            </div>
          </div>
        </div>
      </li>
    );
  })}
</ol>

<style>
  .reels { display: grid; gap: clamp(4rem, 3rem + 4vw, 7rem); }
  .reel-item { border-top: 1px solid var(--line); padding-top: 1rem; }

  /* Header: number + title on the left, description, pills and link from column 7 (the v1 copy line) */
  .reel-head { row-gap: 1rem; align-items: start; margin-bottom: clamp(1.25rem, 1rem + 1vw, 2rem); }
  .rh-left { grid-column: 1 / span 6; display: grid; gap: 0.5rem; }
  .rh-title { font-size: var(--step-2); font-weight: var(--weight-headline); line-height: 1.05; letter-spacing: -0.02em; }
  .rh-title a { background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat; transition: background-size var(--dur-med) var(--ease-out); }
  .rh-title a:hover, .rh-title a:focus-visible { background-size: 100% 2px; }
  .rh-right { grid-column: 7 / -1; display: grid; gap: 1rem; }
  .rh-summary { color: var(--fg-muted); max-width: 52ch; }
  .rh-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .rh-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .rh-tags li { font-size: var(--step--1); padding: 0.3em 0.8em; border-radius: var(--radius-pill); box-shadow: inset 0 0 0 1px var(--line); white-space: nowrap; }
  @media (max-width: 800px) { .rh-left, .rh-right { grid-column: 1 / -1; } }

  /* The reel: full bleed, first slide lines up with the page gutter, the last one runs off the right edge */
  .reel {
    --reel-h: clamp(15rem, 6rem + 22vw, 28rem);   /* header + reel fit one laptop screen */
    width: 100%; max-width: 100vw;
    padding-inline: var(--gutter); scroll-padding-inline: var(--gutter);
    scroll-snap-type: x mandatory; --snap-type: x mandatory;
    outline-offset: -3px;
  }
  .slide { margin-right: var(--gutter); scroll-snap-align: start; }
  .slide:last-child { margin-right: 0; }
  .slide figure { display: grid; gap: 0.6rem; }
  .slide-media { height: var(--reel-h); width: calc(var(--reel-h) * var(--r)); border-radius: var(--radius); overflow: hidden; background: var(--bg-raised); }
  .slide-media :global(img), .slide-media :global(.ph) { width: 100%; height: 100%; object-fit: cover; }

  /* Statement card: the campaign's own line, set big, in the gap between images */
  .slide-quote { height: var(--reel-h); width: calc(var(--reel-h) * 0.85); }
  .quote {
    height: 100%; display: flex; align-items: flex-end; padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-radius: var(--radius); background: var(--invert-bg); color: var(--invert-fg);
    font-size: clamp(1.25rem, 0.9rem + 1.1vw, 1.9rem); font-weight: var(--weight-sub); line-height: var(--leading-sub); letter-spacing: -0.01em;
    text-wrap: balance; white-space: normal;
  }
  .slide-end { height: var(--reel-h); width: calc(var(--reel-h) * 0.6); }
  .end-card {
    height: 100%; display: flex; flex-direction: column; justify-content: space-between;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem); border-radius: var(--radius); box-shadow: inset 0 0 0 1px var(--line);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .end-card:hover { background: var(--bg-raised); }
  .end-title { font-size: var(--step-1); font-weight: var(--weight-sub); line-height: var(--leading-sub); }

  /* Under the reel: a thin progress line in the project colour (echo of v1's loading bars) and the buttons */
  .reel-foot { margin-top: 1rem; align-items: center; row-gap: 0.75rem; }
  .progress { grid-column: 1 / span 9; height: 2px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .progress-fill { display: block; height: 100%; width: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(var(--p, 0)); }
  .reel-nav { grid-column: 10 / -1; display: flex; justify-content: flex-end; gap: 0.5rem; }
  .reel-nav button:disabled { opacity: 0.35; cursor: default; }
  @media (prefers-reduced-motion: reduce) { .reel { scroll-behavior: auto !important; } }
  @media (max-width: 800px) {
    .progress { grid-column: 1 / -1; }
    .reel-nav { display: none; }   /* phones swipe */
    .reel { --reel-h: 46vw; }   /* 16:9 slides ~82vw wide, so the next one peeks in */
  }
</style>
