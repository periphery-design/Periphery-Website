---
const path = Astro.url.pathname;
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="site-header grid">
  <a href="/" class="logo" aria-label="Periphery Design, home">
    <!-- Logo placeholder: swap for the final SVG logo -->
    <span class="logo-mark" aria-hidden="true"></span>
    <span>Periphery Design</span>
  </a>
  <nav class="nav" aria-label="Main">
    <ul>
      {links.map((l) => (
        <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
      <span class="visually-hidden">Dark mode</span>
      <span class="toggle-track" aria-hidden="true"><span class="toggle-dot"></span></span>
      <span data-theme-label aria-hidden="true">Light</span>
    </button>
  </nav>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    height: var(--header-h); align-items: center;
    font-size: var(--step--1);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .logo { grid-column: 1 / span 6; display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 500; }
  .logo-mark { width: 1.1rem; height: 1.1rem; border-radius: 50%; border: 1.5px solid currentColor; }
  .nav { grid-column: 7 / -1; display: flex; justify-content: space-between; align-items: center; }
  .nav ul { display: flex; gap: 1.25rem; }
  .nav a { color: var(--fg-muted); transition: color var(--dur-fast) var(--ease-out); }
  .nav a:hover, .nav a[aria-current='page'] { color: var(--fg); }

  .theme-toggle { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--fg-muted); }
  .theme-toggle:hover { color: var(--fg); }
  .toggle-track {
    width: 1.9rem; height: 1.1rem; border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line); position: relative;
  }
  .toggle-dot {
    position: absolute; top: 3px; left: 3px; width: calc(1.1rem - 6px); height: calc(1.1rem - 6px);
    border-radius: 50%; background: var(--fg);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  :global([data-theme='dark']) .toggle-dot { transform: translateX(0.8rem); }

  @media (max-width: 800px) {
    .logo { grid-column: 1 / span 6; }
    .nav { grid-column: 7 / -1; justify-content: flex-end; gap: 1rem; }
    .nav ul { gap: 0.9rem; }
    .theme-toggle [data-theme-label] { display: none; }
  }
</style>
