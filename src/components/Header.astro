---
import Emblem from './Emblem.astro';
import Wordmark from './Wordmark.astro';
const path = Astro.url.pathname;
const { themeLocked = false } = Astro.props as { themeLocked?: boolean };
const links = [
  { href: '/work/', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<!-- Three columns: logo left, navigation centred on the page, an empty column right to keep it centred -->
<header class="site-header">
  <!-- Lockup: the eye emblem beside the stacked wordmark. On the homepage it waits off-screen while the big
       wordmark is in view, then drops in once that has scrolled away (site.ts, [data-dock]). -->
  <a href="/" class="logo" aria-label="Periphery Studio, home" data-dock-logo>
    <Emblem class="logo-emblem" />
    <span class="logo-word"><Wordmark /></span>
  </a>
  <nav class="nav" aria-label="Main">
    <ul>
      {links.map((l) => (
        <li>
          <!-- Rolling link (same roll-up-once as the homepage titles, see site.ts) -->
          <a href={l.href} data-roll-once aria-current={path.startsWith(l.href.replace(/\/$/, '')) ? 'page' : undefined}>
            <span class="roll">
              <span class="roll-a">{l.label}</span>
              <span class="roll-b" aria-hidden="true">{l.label}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="tools">
    <!-- Wireframe 4: no theme toggle; this column stays to keep the navigation centred -->
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    height: var(--header-h); padding-inline: var(--gutter);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem;
    font-size: var(--step--1);
    background: color-mix(in srgb, var(--bg) 94%, transparent);   /* near-solid so content scrolling under reads cleanly */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .logo { justify-self: start; display: inline-flex; align-items: center; gap: 0.5rem; height: 2rem; }
  .logo :global(.logo-emblem) { height: 1.75rem; }
  .logo-word { display: block; height: 100%; }
  /* Homepage: the big wordmark is the logo while it's on screen. Once it has scrolled away, the lockup drops down
     into the corner from above (a little overshoot as it lands); scroll back up and it lifts away again. */
  :global(html.js[data-dock]) .logo {
    transform: translateY(-160%); opacity: 0; visibility: hidden;
    transition: transform 380ms cubic-bezier(0.5, 0, 0.75, 0), opacity 200ms ease 120ms, visibility 0s linear 380ms;
  }
  :global(html.js[data-dock].logo-in) .logo {
    transform: none; opacity: 1; visibility: visible;
    transition: transform 650ms cubic-bezier(0.34, 1.4, 0.64, 1), opacity 200ms ease, visibility 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js[data-dock]) .logo, :global(html.js[data-dock].logo-in) .logo { transform: none; transition: opacity 200ms ease, visibility 0s; }
  }
  .tools { justify-self: end; display: flex; align-items: center; }

  /* Centred nav: all caps, semibold */
  .nav ul { display: flex; gap: 0.4rem; }
  /* Each link sits in a pill shaped like the eye's "o": a wide rounded oblong with squarish shoulders (a squircle
     where the browser supports corner-shape, a plain pill elsewhere). Outline at rest; hover fills it black;
     the current page stays filled. */
  .nav a {
    display: inline-block; color: var(--fg);
    font-size: var(--step--1); font-weight: var(--weight-semi); text-transform: uppercase; letter-spacing: 0.06em;
    padding: 0.55em 1.25em 0.5em;
    border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--fg);
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  @supports (corner-shape: superellipse(1.4)) { .nav a { border-radius: 50%; corner-shape: superellipse(1.4); } }   /* 1.4 matches the "o" */
  .nav a:hover, .nav a:focus-visible, .nav a[aria-current='page'] { background: var(--fg); color: var(--bg); }
  .nav a:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }

  /* Roll: two copies in a one-line window; on hover the first slides up and out, the second slides in */
  .roll {
    --roll-ease: cubic-bezier(0.76, 0, 0.24, 1);
    --roll-dur: 550ms;
    display: grid; overflow: hidden;
    padding-block: 0.1em; margin-block: -0.1em;
  }
  .roll > span { grid-area: 1 / 1; transition: transform var(--roll-dur) var(--roll-ease); }
  .roll-b { transform: translateY(115%); }
  .nav a:global(.is-rolled) .roll-a { transform: translateY(-115%); }
  .nav a:global(.is-rolled) .roll-b { transform: none; }
  .roll:global(.no-anim) > span { transition: none; }
  /* Without JS: a plain roll on hover */
  :global(html:not(.js)) .nav a:hover .roll-a { transform: translateY(-115%); }
  :global(html:not(.js)) .nav a:hover .roll-b { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .roll-b { display: none; }
    .nav a:global(.is-rolled) .roll-a { transform: none; }
  }


  @media (max-width: 800px) {
    .logo-word { display: none; }   /* emblem only, so the centred nav fits */
    .nav ul { gap: 0.3rem; }
    .nav a { padding-inline: 0.9em; }
  }
</style>
