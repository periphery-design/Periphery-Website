---
import Emblem from './Emblem.astro';
import Wordmark from './Wordmark.astro';
const path = Astro.url.pathname;
const { themeLocked = false } = Astro.props as { themeLocked?: boolean };
const links = [
  { href: '/work/', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<!-- Three columns: logo left, navigation centred on the page, theme toggle right -->
<header class="site-header">
  <!-- Lockup: the eye emblem beside the stacked wordmark. On the homepage the big wordmark shrinks onto
       this spot as you scroll (site.ts, [data-dock]); until then the header lockup stays hidden there. -->
  <a href="/" class="logo" aria-label="Periphery Studio, home" data-dock-logo>
    <Emblem class="logo-emblem" />
    <span class="logo-word" data-dock-target><Wordmark /></span>
  </a>
  <nav class="nav" aria-label="Main">
    <ul>
      {links.map((l) => (
        <li>
          <!-- Rolling link (same roll-up-once as the homepage titles, see site.ts) -->
          <a href={l.href} data-roll-once aria-current={path.startsWith(l.href.replace(/\/$/, '')) ? 'page' : undefined}>
            <span class="roll">
              <span class="roll-a">{l.label}</span>
              <span class="roll-b" aria-hidden="true">{l.label}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="tools">
    {!themeLocked && <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
      <span class="visually-hidden">Yellow mode</span>
      <span class="toggle-track" aria-hidden="true"><span class="toggle-dot"></span></span>
      <span data-theme-label aria-hidden="true">Light</span>
    </button>}
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    height: var(--header-h); padding-inline: var(--gutter);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem;
    font-size: var(--step--1);
    background: color-mix(in srgb, var(--bg) 94%, transparent);   /* near-solid so content scrolling under reads cleanly */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .logo { justify-self: start; display: inline-flex; align-items: center; gap: 0.5rem; height: 2rem; }
  .logo :global(.logo-emblem) { height: 1.75rem; }
  .logo-word { display: block; height: 100%; }
  /* Homepage: the big wordmark is the logo until it docks here, so the lockup waits, then fades in */
  :global(html[data-dock]) .logo-word { opacity: var(--dock-done, 0); }
  :global(html[data-dock]) .logo :global(.logo-emblem) { opacity: var(--dock-p, 0); transform: scale(calc(0.6 + 0.4 * var(--dock-p, 0))); transform-origin: 0 50%; }
  .tools { justify-self: end; display: flex; align-items: center; }

  /* Centred nav: all caps, semibold */
  .nav ul { display: flex; gap: clamp(1.25rem, 1rem + 1vw, 2.25rem); }
  .nav a {
    display: inline-block; color: var(--fg-muted);
    font-size: var(--step--1); font-weight: var(--weight-semi); text-transform: uppercase; letter-spacing: 0.06em;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav a:hover, .nav a:focus-visible, .nav a[aria-current='page'] { color: var(--fg); }

  /* Roll: two copies in a one-line window; on hover the first slides up and out, the second slides in */
  .roll {
    --roll-ease: cubic-bezier(0.76, 0, 0.24, 1);
    --roll-dur: 550ms;
    display: grid; overflow: hidden;
    padding-block: 0.1em; margin-block: -0.1em;
  }
  .roll > span { grid-area: 1 / 1; transition: transform var(--roll-dur) var(--roll-ease); }
  .roll-b { transform: translateY(115%); }
  .nav a:global(.is-rolled) .roll-a { transform: translateY(-115%); }
  .nav a:global(.is-rolled) .roll-b { transform: none; }
  .roll:global(.no-anim) > span { transition: none; }
  /* Without JS: a plain roll on hover */
  :global(html:not(.js)) .nav a:hover .roll-a { transform: translateY(-115%); }
  :global(html:not(.js)) .nav a:hover .roll-b { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .roll-b { display: none; }
    .nav a:global(.is-rolled) .roll-a { transform: none; }
  }

  .theme-toggle { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--fg-muted); }
  .theme-toggle:hover { color: var(--fg); }
  .toggle-track {
    width: 1.9rem; height: 1.1rem; border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line); position: relative;
    transition: background-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .toggle-dot {
    position: absolute; top: 3px; left: 3px; width: calc(1.1rem - 6px); height: calc(1.1rem - 6px);
    border-radius: 50%; background: var(--fg);
    transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  /* Switched on (yellow page, or a case study locked dark): the dot slides across */
  :global([data-theme='yellow']) .toggle-dot, :global([data-theme='dark']) .toggle-dot { transform: translateX(0.8rem); }
  :global([data-theme='yellow']) .toggle-track { box-shadow: inset 0 0 0 1.5px var(--fg); }

  @media (max-width: 800px) {
    .logo-word { display: none; }   /* emblem only, so the centred nav fits */
    .nav ul { gap: 1rem; }
    .theme-toggle [data-theme-label] { display: none; }
  }
</style>
