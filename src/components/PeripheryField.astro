---
// Wireframe 3 homepage hero: the statement and a goat eye in the centre, the campaigns floating at the
// edges of the screen. Each card drifts slowly on its own rhythm; on hover (or keyboard focus) it grows a
// little, lifts on a soft shadow and shows its title, and the eye turns to look at it.
// The eye is layered from the owner's goat-eye photo (public/eye): base, moving pupil, and lids for the squint.
// Phones: eye and statement on top, the cards in a gently floating two-column grid underneath.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props { projects: CollectionEntry<'projects'>[]; headline: string; subheading: string; }
const { projects, headline, subheading } = Astro.props;
const cards = projects.filter((p) => p.data.homeCard).slice(0, 6);
// Spots around the edge of the screen: [css position, tilt in degrees, float duration s, float delay s]
const spots: [string, number, number, number][] = [
  ['top: 5%; left: 4%;', -4, 9, 0],
  ['top: 8%; right: 5%;', 3, 11, -3],
  ['bottom: 7%; left: 10%;', 3, 10, -6],
  ['bottom: 4%; right: 9%;', -3, 12, -2],
  ['top: 40%; left: 1.5%;', 2, 13, -8],
  ['top: 42%; right: 1.5%;', -2, 10.5, -4],
];
---
<section class="pf" aria-labelledby="hero-h" data-pf>
  <div class="pf-centre">
    <!-- The eye, in four layers cut from one photo: the empty eye, the pupil (moves), and the fur above and
         below (the lids, which close slightly into a squint when the eye settles on a project) -->
    <div class="pf-eye" aria-hidden="true" data-eye>
      <img class="eye-base" src="/eye/eye.webp" alt="" width="1400" height="781" />
      <div class="eye-ball"><img class="eye-pupil" src="/eye/pupil.webp" alt="" data-eye-pupil /></div>
      <img class="eye-lid eye-lid-top" src="/eye/lid-top.webp" alt="" />
      <img class="eye-lid eye-lid-bottom" src="/eye/lid-bottom.webp" alt="" />
    </div>
    <h1 id="hero-h" class="hero-h" aria-label={headline}>
      {headline.split(' ').map((w, i) => <span class="w" style={`--d: ${i}`} aria-hidden="true">{w}</span>)}
    </h1>
    <p class="hero-sub">{subheading}</p>
  </div>

  <ul class="pf-cards" aria-label="Selected work">
    {cards.map((p, i) => {
      const d = p.data;
      const [pos, tilt, dur, delay] = spots[i % spots.length];
      return (
        <li class="pf-spot" style={`${pos} --tilt: ${tilt}deg; --dur: ${dur}s; --delay: ${delay}s;`}>
          <a href={`/work/${p.id}/`} class="pf-card" aria-label={`${d.title} — ${d.client}`} data-pf-card>
            <Image src={d.homeCard!.image} alt="" widths={[300, 500, 700]} sizes="(min-width: 900px) 16vw, 45vw" loading="eager" style={`object-position: ${d.homeCard!.focus}`} />
            {d.homeCard!.video && <video class="card-video" src={d.homeCard!.video} muted loop playsinline preload="none" aria-hidden="true" data-card-video></video>}
            <span class="pf-title" aria-hidden="true">{d.title}</span>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .pf {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: grid; place-items: center;
    padding: 2rem var(--gutter);
    overflow: hidden;
  }

  /* ---------- Centre: eye + statement ---------- */
  .pf-centre { position: relative; z-index: 1; display: grid; justify-items: center; gap: clamp(1rem, 0.75rem + 1vw, 1.75rem); text-align: center; max-width: 34rem; }
  /* Eye: fades out on every side (top and bottom especially) and multiplies its white into the page */
  .pf-eye {
    position: relative; width: clamp(18rem, 10rem + 28vw, 40rem); aspect-ratio: 1400 / 781;
    overflow: hidden; mix-blend-mode: multiply;
    --fade: linear-gradient(to bottom, transparent 0%, #000 24%, #000 76%, transparent 100%),
            linear-gradient(to right, transparent 4%, #000 26%, #000 74%, transparent 96%);
    -webkit-mask-image: var(--fade); mask-image: var(--fade);
    -webkit-mask-composite: source-in; mask-composite: intersect;
  }
  :global([data-theme='dark']) .pf-eye { mix-blend-mode: normal; }
  .pf-eye img { position: absolute; display: block; }
  .eye-base, .eye-lid { inset: 0; width: 100%; height: 100%; }
  /* The pupil can only move inside the eyeball */
  .eye-ball { position: absolute; inset: 0; clip-path: ellipse(18% 22% at 50% 50.2%); }
  .eye-pupil { left: 40.75%; top: 41.94%; width: 19.5%; height: auto; will-change: transform; }
  /* Squint: the fur above and below closes in a little */
  .eye-lid { transition: transform 450ms var(--ease-out); }
  [data-pf].is-looking .eye-lid-top { transform: translateY(5%); }
  [data-pf].is-looking .eye-lid-bottom { transform: translateY(-3.5%); }

  .hero-h {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 0.8rem + 2.6vw, 3.25rem);
    line-height: 1; letter-spacing: -0.03em; font-weight: var(--weight-headline);
    max-width: 14ch;
  }
  .hero-sub { font-size: clamp(0.8125rem, 0.75rem + 0.25vw, 0.9375rem); font-weight: var(--weight-sub); color: var(--fg-muted); max-width: 36ch; line-height: var(--leading-sub); }
  .w { display: inline-block; margin-inline: 0.12em; }
  .js .w { opacity: 0; transform: translateY(0.35em); animation: rise 900ms var(--ease-out) forwards; animation-delay: calc(120ms + var(--d) * 90ms); }
  .js .hero-sub { opacity: 0; animation: fade 900ms var(--ease-out) 650ms forwards; }
  @keyframes rise { to { opacity: 1; transform: none; } }
  @keyframes fade { to { opacity: 1; } }

  /* ---------- The cards at the edges ---------- */
  .pf-cards { position: absolute; inset: 0; }
  .pf-spot {
    position: absolute; width: clamp(8.5rem, 3rem + 11vw, 15rem);
    rotate: var(--tilt);
    animation: drift var(--dur) ease-in-out var(--delay) infinite alternate;   /* slow float, each on its own rhythm */
  }
  @keyframes drift {
    0%   { translate: 0 0; }
    50%  { translate: 6px -12px; }
    100% { translate: -5px 8px; }
  }
  .pf-card {
    position: relative; display: block; aspect-ratio: 4 / 5; border-radius: var(--radius); overflow: hidden;
    background: var(--bg-raised);
    box-shadow: 0 0.75rem 2rem -0.75rem rgb(0 0 0 / 0.12);
    transition: transform 500ms var(--ease-out), box-shadow 500ms var(--ease-out), rotate 500ms var(--ease-out);
  }
  .pf-card :global(img), .card-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .card-video { opacity: 0; transition: opacity 400ms ease; }
  .card-video:global(.is-playing) { opacity: 1; }
  /* Hover / focus: grows a little, straightens, lifts, shows the title */
  .pf-card:hover, .pf-card:focus-visible { transform: scale(1.08); rotate: calc(var(--tilt) * -1); box-shadow: 0 1.25rem 2.5rem -0.75rem rgb(0 0 0 / 0.18); z-index: 2; }
  .pf-spot:has(.pf-card:hover), .pf-spot:has(.pf-card:focus-visible) { z-index: 2; }
  .pf-title {
    position: absolute; inset: auto 0 0 0; padding: 2.5rem 0.9rem 0.9rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0));
    color: #fff; font-size: var(--step-0); font-weight: var(--weight-sub); line-height: var(--leading-sub);
    opacity: 0; transform: translateY(0.5rem); transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
  }
  .pf-card:hover .pf-title, .pf-card:focus-visible .pf-title { opacity: 1; transform: none; }
  @media (hover: none) { .pf-title { opacity: 1; transform: none; } }

  /* ---------- Phones / narrow: statement on top, cards in a floating grid below ---------- */
  @media (max-width: 900px) {
    .pf { min-height: 0; display: block; padding-block: 2.5rem 3rem; }
    .pf-centre { margin-inline: auto; margin-bottom: 2.5rem; }
    .pf-cards { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); width: 100%; }
    .pf-spot { position: static; width: auto; }
    .pf-spot:nth-child(even) { margin-top: 2rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-spot { animation: none; }
    .js .w, .js .hero-sub { opacity: 1; transform: none; animation: none; }
  }
</style>
