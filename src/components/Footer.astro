---
import { Image } from 'astro:assets';
import glow from '../assets/backgrounds/glow.jpg';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <!-- The sign-off: a warm colour field (the owner's gradient) that fades up behind the footer and drifts slowly,
       with a fine grain standing still on top. Same on every page, light or dark. -->
  <div class="ft-glow" aria-hidden="true"><Image src={glow} alt="" widths={[1125]} sizes="100vw" format="jpg" quality={90} loading="lazy" /><span class="grain"></span></div>
  <div class="grid cta" data-reveal>
    <p class="label">Start something</p>
    <div class="content">
      <p class="statement">Have a brand with something to say? Let’s make it impossible to ignore.</p>
      <p class="cta-actions">
        <a class="pill" href="mailto:hello@example.com">hello@example.com <span class="arrow">↗</span></a>
        <a class="pill ghost" href="/contact">Contact page</a>
      </p>
    </div>
  </div>

  <div class="grid bottom">
    <ul class="social">
      <li><a href="https://www.behance.net/TandersonCreative">Behance</a></li>
      <li><a href="#">Instagram</a></li>
      <li><a href="#">LinkedIn</a></li>
    </ul>
    <p class="meta legal">© {year} Periphery Studio</p>
  </div>

  <!-- Oversized wordmark, after Nonstop. Replaced by the logo once it exists. -->
  <p class="wordmark" aria-hidden="true">Periphery</p>
</footer>

<style>
  .site-footer {
    position: relative; isolation: isolate; margin-top: var(--section); overflow: hidden;
    /* The footer always reads dark-on-light over the colour, whatever the page's theme */
    --fg: #111111; --fg-muted: #4b4a3c; --line: rgb(0 0 0 / 0.14);
    --invert-bg: #111111; --invert-fg: #f6f6f5; --placeholder: rgb(0 0 0 / 0.08);
    color: var(--fg);
  }
  .ft-glow {
    position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; background: var(--bg);
    /* rises out of the page: transparent at the very top, full colour from about a third of the way down */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 38%);
            mask-image: linear-gradient(to bottom, transparent 0, #000 38%);
  }
  .ft-glow :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 70%;
    /* Slight drift, like light shifting across a wall (transform only, long loop) */
    transform-origin: 50% 50%;
    animation: glow-drift 30s ease-in-out infinite alternate;
  }
  @keyframes glow-drift {
    0%   { transform: scale(1.06) translate(-1.5%, -1%); }
    50%  { transform: scale(1.1) translate(1.5%, 1%); }
    100% { transform: scale(1.07) translate(-0.5%, 1.5%); }
  }
  @media (prefers-reduced-motion: reduce) { .ft-glow :global(img) { animation: none; transform: scale(1.06); } }
  /* Dark pages: a fade from black into yellow turns muddy, so the footer rises as a clean sheet with rounded top corners */
  :global([data-theme='dark']) .site-footer { border-radius: calc(var(--radius) * 2) calc(var(--radius) * 2) 0 0; }
  :global([data-theme='dark']) .ft-glow { -webkit-mask-image: none; mask-image: none; }
  /* Film grain on top, at screen resolution and standing still while the colour drifts underneath, so it stays
     crisp at any width. The grain is a small generated tile, matched to the strength of the grain in the owner's image */
  .grain {
    position: absolute; inset: 0; pointer-events: none; opacity: 1;
    background-image: url("data:image/png;base64,");
    background-size: 160px 160px; image-rendering: pixelated;
  }

  .cta { padding-block: 4rem 6rem; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 2rem; }
  .bottom { font-size: var(--step--1); align-items: end; }
  .social { grid-column: 1 / span 6; display: flex; gap: 1.25rem; }
  .social a { color: var(--fg-muted); transition: color var(--dur-fast) var(--ease-out); }
  .social a:hover { color: var(--fg); }
  .legal { grid-column: 7 / -1; text-align: right; }
  .wordmark {
    font-family: var(--font-display);
    font-size: var(--step-4); line-height: 0.8; letter-spacing: -0.04em; font-weight: var(--weight-headline);
    white-space: nowrap; color: var(--placeholder);
    margin-top: 2rem; margin-bottom: -0.12em; padding-inline: calc(var(--gutter) * 0.5);
  }
</style>
