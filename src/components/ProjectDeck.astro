---
// Selected work. On desktop each card pins under the header and the next card slides over it,
// leaving the previous card's title strip visible — the "collapse" stack from Nonstop.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';

interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;
---
<ol class="deck" style={`--count: ${projects.length}`}>
  {projects.map((p, i) => (
    <li class="card" style={`--i: ${i}`}>
      <a href={`/work/${p.id}/`} class="card-link grid" data-roll-once>
        <!-- Images are decorative here: the link is named by the title. Full alt text is on the project page.
             Carousel: up to 3 images cross-fade in turn; the bars along the bottom fill like a loading bar in
             the project's accent colour, then the next image comes in. Placeholder projects show 3 grey slides. -->
        <div class="card-media" data-carousel style={`--accent: ${p.data.accent ?? 'var(--fg)'}`}>
          {(p.data.carousel.length ? p.data.carousel : p.data.cover ? [p.data.cover] : [null, null, null]).map((img, n, all) => (
            <div class:list={['slide', n === 0 && 'is-active']} data-slide>
              {img
                ? <Image src={img} alt="" widths={[600, 1000, 1400]} sizes="(min-width: 800px) 50vw, 100vw" loading={n === 0 ? 'eager' : 'lazy'} />
                : <Placeholder label={`${p.data.client} — image ${n + 1}`} ratio="16 / 11" />}
            </div>
          ))}
          {(p.data.carousel.length > 1 || !p.data.cover) && (
            <div class="bars" aria-hidden="true">
              {(p.data.carousel.length ? p.data.carousel : [0, 1, 2]).map(() => <span class="bar"><span class="fill"></span></span>)}
            </div>
          )}
        </div>
        <div class="card-text">
          <div class="card-head">
            <!-- Rolling title (after Spiegel): two stacked copies in a one-line window; on hover the
                 first slides up and out while the second slides up into place. -->
            <h3 class="card-title roll">
              <span class="roll-a">{p.data.title}</span>
              <span class="roll-b" aria-hidden="true">{p.data.title}</span>
            </h3>
            <span class="arrow" aria-hidden="true">↗</span>
          </div>
          <p class="card-summary">{p.data.summary}</p>
          {p.data.tags.length > 0 && <ul class="card-tags" aria-label="Disciplines">{p.data.tags.map((t) => <li>{t}</li>)}</ul>}
        </div>
      </a>
    </li>
  ))}
</ol>

<style>
  .deck { --bar: 3.25rem; position: relative; }
  .card {
    position: sticky;
    top: calc(var(--header-h) + var(--i) * var(--bar));
    background: var(--bg);
    border-top: 1px solid var(--line);
  }
  .card-link { padding-block: 0.9rem 2.5rem; row-gap: 1rem; }
  .card-media { grid-column: 1 / span 6; position: relative; overflow: hidden; border-radius: var(--radius); aspect-ratio: 16 / 11; isolation: isolate; }
  .card-media :global(img), .card-media :global(.ph) { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }

  /* ---------- Carousel ---------- */
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 700ms var(--ease-inout); }
  .slide.is-active { opacity: 1; z-index: 1; }
  .bars {
    --dwell: 4.5s;   /* how long each image stays up */
    position: absolute; z-index: 2; left: 0.9rem; right: 0.9rem; bottom: 0.9rem;
    display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 0.4rem;
  }
  .bar {
    height: 3px; border-radius: var(--radius-pill); overflow: hidden;
    background: rgb(255 255 255 / 0.32);
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.12);
  }
  .fill { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .bar.is-done .fill { transform: scaleX(1); }
  .bar.is-active .fill { animation: load var(--dwell) linear forwards; }
  @keyframes load { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  /* Hold still while someone is looking (hover/focus), when off screen, or when the tab is hidden */
  .card-link:hover .bar.is-active .fill,
  .card-link:focus-visible .bar.is-active .fill,
  [data-carousel].is-paused .bar.is-active .fill { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .bar.is-active .fill { animation: none; transform: scaleX(1); }
    .slide { transition: none; }
  }
  .card-text { grid-column: 7 / -1; display: flex; flex-direction: column; gap: 0.35rem; }
  .card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .card-title { font-size: var(--step-1); font-weight: var(--weight-sub); }
  .card-summary { max-width: 52ch; color: var(--fg-muted); }
  /* Pill tags at the foot of the card, same style as the capability tags */
  .card-tags { margin-top: auto; padding-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .card-tags li {
    font-size: var(--step--1); padding: 0.3em 0.8em; border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line); white-space: nowrap;
  }

  /* Hover: rolling title (after Spiegel), slow image push-in, arrow nudge */
  .roll {
    --roll-ease: cubic-bezier(0.76, 0, 0.24, 1);
    --roll-dur: 550ms;
    display: grid; overflow: hidden;
    /* A little room so descenders (g, y) aren't clipped by the window */
    padding-block: 0.08em 0.14em; margin-block: -0.08em -0.14em;
  }
  .roll > span { grid-area: 1 / 1; transition: transform var(--roll-dur) var(--roll-ease); }
  .roll-b { transform: translateY(115%); }
  /* Rolls up once per hover and stays up (see site.ts: the reset back is instant and invisible, since both
     copies of the title are the same). Without JS it falls back to a plain hover roll. */
  .card-link.is-rolled .roll-a { transform: translateY(-115%); }
  .card-link.is-rolled .roll-b { transform: none; }
  .roll.no-anim > span { transition: none; }
  :global(html:not(.js)) .card-link:hover .roll-a { transform: translateY(-115%); }
  :global(html:not(.js)) .card-link:hover .roll-b { transform: none; }
  @media (hover: hover) {
    .card-link:hover .card-media :global(img), .card-link:hover .card-media :global(.ph) { transform: scale(1.03); }
  }

  /* Mobile: no pinning, simple stacked cards */
  @media (max-width: 800px) {
    .card { position: static; }
    .card-media, .card-text { grid-column: 1 / -1; }
    .card-summary { margin-top: 0.25rem; }
  }
</style>
