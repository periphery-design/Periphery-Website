---
// Wireframe 2 homepage: one row of vertical campaign cards straight under the headline.
// Mouse: Blossom drag with momentum; sideways trackpad swipes move it too. The vertical wheel always scrolls the page.
// Touch: the phone's own swipe. Keyboard: tab through the cards, or Previous / Next.
// Hover: the whole image card grows a little and lifts on a very faint grey shadow; the words stay put.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import '@blossom-carousel/core/style.css';

interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<div class="home-reel" data-reel>
  <ul class="reel" blossom-carousel aria-label="Selected work">
    {projects.map((p, i) => {
      const d = p.data;
      const img = d.homeCard?.image ?? d.cover;
      return (
        <li class="card">
          <a href={`/work/${p.id}/`} class="card-link">
            <div class="card-media">
              {img
                ? <Image src={img} alt="" widths={[400, 640, 900]} sizes="(min-width: 800px) 30vw, 72vw" loading={i < 3 ? 'eager' : 'lazy'} style={`object-position: ${d.homeCard?.focus ?? '50% 50%'}`} />
                : <Placeholder label={`${d.client} — key visual`} ratio="4 / 5" />}
            </div>
            <div class="card-text">
              <span class="meta">{pad(i + 1)}</span>
              <h2 class="card-title">{d.title}</h2>
              <span class="meta card-client">{d.client}</span>
            </div>
          </a>
        </li>
      );
    })}
    <li class="card card-end">
      <a href="/work/" class="end-card">
        <span class="meta">{projects.length} campaigns</span>
        <span class="end-title">All work <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </li>
  </ul>
  <div class="grid reel-foot">
    <div class="progress" aria-hidden="true"><span class="progress-fill"></span></div>
    <div class="reel-nav">
      <button type="button" class="pill ghost" data-reel-prev>Previous</button>
      <button type="button" class="pill ghost" data-reel-next>Next</button>
    </div>
  </div>
</div>

<style>
  .reel {
    --card-h: clamp(20rem, 10rem + 24vw, 34rem);   /* image height; width follows at 4:5 */
    width: 100%; max-width: 100vw;
    padding-inline: var(--gutter); scroll-padding-inline: var(--gutter);
    /* Room above and below so a grown card and its shadow aren't clipped by the scroller */
    padding-block: 1.5rem 2rem; margin-block: -1.5rem -2rem;
    scroll-snap-type: x proximity; --snap-type: x proximity;
  }
  /* Mouse / trackpad: free movement (drag momentum, trackpad) with no snapping back. Touch keeps snapping. */
  @media (pointer: fine) { .reel { scroll-snap-type: none; --snap-type: none; } }
  .card { width: calc(var(--card-h) * 0.8); margin-right: var(--gutter); scroll-snap-align: start; }
  .card:last-child { margin-right: 0; }
  .card-link { display: grid; gap: 0.9rem; }

  /* The image card. On hover the whole frame grows slightly and lifts on a very faint light-grey shadow. */
  .card-media {
    position: relative; height: var(--card-h); border-radius: var(--radius); overflow: hidden;
    background: var(--bg-raised); isolation: isolate;
    box-shadow: 0 0.75rem 2rem -0.5rem rgb(0 0 0 / 0);
    transition: transform 500ms var(--ease-out), box-shadow 500ms var(--ease-out);
  }
  .card-media :global(img), .card-media :global(.ph) { width: 100%; height: 100%; object-fit: cover; }
  @media (hover: hover) and (pointer: fine) {
    .card-link:hover .card-media { transform: scale(1.03); box-shadow: 0 0.75rem 2rem -0.5rem rgb(0 0 0 / 0.08); }
  }
  .card-link:focus-visible .card-media { transform: scale(1.03); box-shadow: 0 0.75rem 2rem -0.5rem rgb(0 0 0 / 0.08); }
  .card-link:focus-visible { outline: none; }
  .card-link:focus-visible .card-media { outline: 2px solid var(--fg); outline-offset: 3px; }

  .card-text { display: grid; gap: 0.2rem; }
  .card-title { font-size: var(--step-1); font-weight: var(--weight-sub); line-height: var(--leading-sub); }
  .card-client { color: var(--fg-muted); }

  /* Last card: the way into the full list */
  .card-end { width: calc(var(--card-h) * 0.55); }
  .end-card {
    height: var(--card-h); display: flex; flex-direction: column; justify-content: space-between;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem); border-radius: var(--radius); box-shadow: inset 0 0 0 1px var(--line);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .end-card:hover { background: var(--bg-raised); }
  .end-title { font-size: var(--step-1); font-weight: var(--weight-sub); }

  /* Under the reel: a thin progress line and Previous / Next */
  .reel-foot { margin-top: 1.25rem; align-items: center; row-gap: 0.75rem; }
  .progress { grid-column: 1 / span 9; height: 2px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .progress-fill { display: block; height: 100%; width: 100%; background: var(--fg); transform-origin: 0 50%; transform: scaleX(var(--p, 0)); }
  .reel-nav { grid-column: 10 / -1; display: flex; justify-content: flex-end; gap: 0.5rem; }
  .reel-nav button:disabled { opacity: 0.35; cursor: default; }

  @media (prefers-reduced-motion: reduce) {
    .reel { scroll-behavior: auto !important; }
    .card-media { transition: none; }
  }
  @media (max-width: 800px) {
    .reel { --card-h: 90vw; }   /* cards ~72vw wide, so the next one peeks in */
    .progress { grid-column: 1 / -1; }
    .reel-nav { display: none; }
  }
</style>
